  "blueprints": [
    {
      "key": "biochar_sequestration_1000_year_f_durable_max",
      "display_name": "Biochar sequestration, 1000 year durability",
      "description": "Amount of CO₂ stored via biochar sequestration, given biochar mass and samples evidencing random reflectance properties and carbon content. Applicable to the 1000 year durability option from the Biochar Storage in Soil Environments module based on assessment of biochar permanence according to Sanei et al. (2024). Durable fraction capped at 0.95 per protocol requirements.",
      "type": "SEQUESTRATION",
      "inputs": [
        {
          "input_key": "inorganic_carbon_contents",
          "description": "Inorganic carbon content of biochar",
          "data_shape": "LIST",
          "quantity_kind": "mass_fraction_dry_basis",
          "compatible_unit": "mg / kg"
        },
        {
          "input_key": "product_mass",
          "description": "Mass of product",
          "data_shape": "SCALAR",
          "quantity_kind": "mass",
          "compatible_unit": "kg"
        },
        {
          "input_key": "s_fraction",
          "description": "Fraction of reflectance samples above 2% benchmark in each sample",
          "data_shape": "LIST",
          "quantity_kind": "dimensionless_ratio",
          "compatible_unit": "%"
        },
        {
          "input_key": "total_carbon_contents",
          "description": "Total carbon content of biochar",
          "data_shape": "LIST",
          "quantity_kind": "mass_fraction_dry_basis",
          "compatible_unit": "mg / kg"
        }
      ],
      "expressions": [
        {
          "key": "num_samples",
          "template": "length({s_fraction})",
          "inputs": [
            {
              "template_key": "s_fraction",
              "input_key": "s_fraction",
              "type": "DATAPOINT",
              "data_shape": "LIST"
            }
          ]
        },
        {
          "key": "s_standard_error",
          "template": "sqrt(mean({s_fraction}) * complement_of(mean({s_fraction})) / {num_samples})",
          "inputs": [
            {
              "template_key": "num_samples",
              "input_key": "num_samples",
              "type": "EXPRESSION_RESULT",
              "data_shape": "SCALAR"
            },
            {
              "template_key": "s_fraction",
              "input_key": "s_fraction",
              "type": "DATAPOINT",
              "data_shape": "LIST"
            },
            {
              "template_key": "s_fraction",
              "input_key": "s_fraction",
              "type": "DATAPOINT",
              "data_shape": "LIST"
            }
          ]
        },
        {
          "key": "durable_fraction_calc",
          "template": "mean({s_fraction}) - {s_standard_error}",
          "inputs": [
            {
              "template_key": "s_fraction",
              "input_key": "s_fraction",
              "type": "DATAPOINT",
              "data_shape": "LIST"
            },
            {
              "template_key": "s_standard_error",
              "input_key": "s_standard_error",
              "type": "EXPRESSION_RESULT",
              "data_shape": "SCALAR"
            }
          ]
        },
        {
          "key": "durable_fraction",
          "template": "min({durable_fraction_calc}, {max_durable_fraction})",
          "inputs": [
            {
              "template_key": "durable_fraction_calc",
              "input_key": "durable_fraction_calc",
              "type": "EXPRESSION_RESULT",
              "data_shape": "SCALAR"
            }
          ]
        },
        {
          "key": "carbon_contents",
          "template": "{total_carbon_contents} - {inorganic_carbon_contents}",
          "inputs": [
            {
              "template_key": "inorganic_carbon_contents",
              "input_key": "inorganic_carbon_contents",
              "type": "DATAPOINT",
              "data_shape": "LIST"
            },
            {
              "template_key": "total_carbon_contents",
              "input_key": "total_carbon_contents",
              "type": "DATAPOINT",
              "data_shape": "LIST"
            }
          ]
        },
        {
          "key": "mean_carbon_content",
          "template": "mean({carbon_contents})",
          "inputs": [
            {
              "template_key": "carbon_contents",
              "input_key": "carbon_contents",
              "type": "EXPRESSION_RESULT",
              "data_shape": "LIST"
            }
          ]
        },
        {
          "key": "output",
          "template": "{product_mass} * {mean_carbon_content} * {durable_fraction} * {co2e_of_carbon}",
          "inputs": [
            {
              "template_key": "durable_fraction",
              "input_key": "durable_fraction",
              "type": "EXPRESSION_RESULT",
              "data_shape": "SCALAR"
            },
            {
              "template_key": "mean_carbon_content",
              "input_key": "mean_carbon_content",
              "type": "EXPRESSION_RESULT",
              "data_shape": "SCALAR"
            },
            {
              "template_key": "product_mass",
              "input_key": "product_mass",
              "type": "DATAPOINT",
              "data_shape": "SCALAR"
            }
          ]
        }
      ]
    },

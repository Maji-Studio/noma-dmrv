{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-api-records",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sweep-document-uploads",
      "schedule": "15 3 * * *"
    }
  ]
}

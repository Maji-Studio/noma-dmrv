# Database (Local Development with Docker)
# For local development, use: postgresql://postgres:postgres@localhost:5432/app_template_dev
# For production, use your hosted PostgreSQL URL (Vercel Postgres, Supabase, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_template_dev

# Docker PostgreSQL Configuration (optional overrides)
# Uncomment and modify these if you need to change defaults
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=app_template_dev
# POSTGRES_PORT=5432

# App URL (used by Better Auth and other services)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Better Auth
BETTER_AUTH_SECRET=your-32-character-secret-here-change-this

# Email (Resend)
# Optional for local development (auth links will be logged to server console)
# Required for production email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ALLOW_SELF_SIGNUP=false

# Optional
LOG_LEVEL=info

# Database Pool (optional tuning)
# DB_POOL_MAX is a per-environment deployment decision, NOT a one-size default.
# The code falls back to max=1 — a conservative value that keeps per-instance
# connection usage low. It is NOT a guarantee: many concurrent instances each
# holding their own pool can still exhaust the database's total connection
# ceiling, so set DB_POOL_MAX explicitly per env:
#   - Serverless (Vercel): keep it LOW (1-3) and use a Transaction-mode pooler
#     (port 6543). Each function instance opens its own pool, so pools multiply.
#   - Long-running server/container: size it to (DB connection ceiling /
#     number of app instances) — e.g. 10-20 for a single instance.
# Defaults: max=1, idle_timeout=10s, connection_timeout=10s
# DB_POOL_MAX=1
# DB_POOL_IDLE_TIMEOUT_MS=10000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000

# SSL Configuration
# Set to "true" to skip SSL certificate verification for remote databases
# (e.g., self-signed certs, Supabase transaction pooler). Default: strict verification.
# PG_ALLOW_UNVERIFIED_SSL=true

# Isometric Certify API (optional)
# Generate both credentials in Certify UI → Team settings (https://registry.isometric.com/account/team-settings).
# Both must be set together; client absent → IsometricApiError("not_configured") at call time.
# ISOMETRIC_ENVIRONMENT defaults to "sandbox" — set to "production" only for live submissions.
# ISOMETRIC_CLIENT_SECRET=
# ISOMETRIC_ACCESS_TOKEN=
# ISOMETRIC_ENVIRONMENT=sandbox
#
# Allowlist of host suffixes the Sources mirror flow will PUT bytes to.
# Defaults cover Isometric's documented S3-compatible storage hosts; the
# sandbox currently issues GCS-backed presigned URLs, so add
# .storage.googleapis.com when targeting sandbox.
# ISOMETRIC_UPLOAD_HOST_ALLOWLIST=.s3.amazonaws.com,.amazonaws.com,.isometric.com,.digitaloceanspaces.com,.storage.googleapis.com
#
# Allowlist for the /api/documents/[id] legacy-`fileUrl` redirect. Leave empty
# to use the safe narrow defaults (.s3.amazonaws.com + regional/dualstack S3,
# .isometric.com, .digitaloceanspaces.com, .storage.googleapis.com — plus your
# own origin and STORAGE_ENDPOINT). Set it to pin redirects to the exact
# Isometric report bucket/host; a non-empty value REPLACES the defaults.
# ISOMETRIC_STORAGE_REDIRECT_HOSTS=isometric-reports-prod.s3.eu-west-1.amazonaws.com
#
# Opt-in for the sandbox integration tests + the daily GitHub Actions
# health-check workflow (.github/workflows/isometric-health.yml). Set
# locally to run `pnpm test:integration` against the live sandbox; in
# CI these are read from repo secrets of the same name.
#   RUN_ISOMETRIC_SANDBOX_TESTS=1     → enables the opt-in vitest gate
#   ISOMETRIC_DEMO_PROJECT_ID=prj_…   → the sandbox demo project to read
# Both are read by tests/isometric-sandbox.integration.test.ts and by the
# scripts/isometric-smoke.ts CLI; the demo project id is asserted to
# appear in the live GET /projects response, so a stale id surfaces as
# a test failure before any write path runs.
# RUN_ISOMETRIC_SANDBOX_TESTS=1
# ISOMETRIC_DEMO_PROJECT_ID=prj_…

# Object storage (file uploads)
# Defaults to 'local-fs' in dev/test — files land in .storage/ (gitignored).
# Production REQUIRES STORAGE_PROVIDER='s3-compatible' with full credentials below.
STORAGE_PROVIDER=local-fs
# STORAGE_BUCKET=noma-dev
# STORAGE_REGION=fra1
# # DO Spaces endpoint (omit for AWS S3):
# STORAGE_ENDPOINT=https://fra1.digitaloceanspaces.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# # local-fs only: directory for object data (default .storage)
# STORAGE_LOCAL_FS_ROOT=.storage
# # local-fs only: 32+ char HMAC secret for URL tokens. If unset, an ephemeral
# # random secret is generated on boot (uploads invalidate on restart — dev only).
# STORAGE_SIGNING_SECRET=

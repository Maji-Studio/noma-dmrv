# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.tpl
!.env.local.tpl

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
playwright-report
test-results

# pdf
.tmp_pdf

.automaker

# claude code
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local-fs storage provider (dev/test only)
.storage/
.storage-test/

# local agent/QA working files
/.scratchpad/
/.codex/scratch/
/.pnpm-store/
/output/
# QA run artifacts: only markdown reports are tracked; screenshots, videos,
# raw driver output, and scripts stay local (docs/organization.md)
docs/archive/qa/artifacts/**
!docs/archive/qa/artifacts/**/
!docs/archive/qa/artifacts/**/*.md
docs/archive/qa/artifacts/**/video/
docs/archive/qa/artifacts/**/runtime/
docs/archive/qa/artifacts/**/screenshots/

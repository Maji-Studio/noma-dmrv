---
// Why noma: a statement and who it's for (hero, with the principles as the page index), then five
// principles, each with a visual proof. Principle 1 is the page's one dark stage (CompareStage: noma vs
// spreadsheets and paper). Section ids come from WHY_PRINCIPLES in src/config.js; Home links to #who,
// #open-source and #mafinga.
import { GITHUB_URL, WHY_PRINCIPLES } from "../config.js";
import SiteShell from "../components/site/SiteShell.astro";
import GetStartedBand from "../components/site/GetStartedBand.astro";
import Button from "../components/site/Button.astro";
import WhyIntro from "../components/site/why/WhyIntro.astro";
import Principle from "../components/site/why/Principle.astro";
import EvidenceProof from "../components/site/why/EvidenceProof.astro";
import MathExcerpt from "../components/site/why/MathExcerpt.astro";
import OwnershipProof from "../components/site/why/OwnershipProof.astro";
import Mafinga from "../components/site/why/Mafinga.astro";
import CompareStage from "../components/site/why/CompareStage.astro";

const [, P2, P3, P4, P5] = WHY_PRINCIPLES;
---
<SiteShell
  current="why"
  title="Why noma | noma"
  description="The five principles behind noma: every figure has a source, evidence stays with the record, the math is public, your data stays yours, and it is built where biochar is made."
>
  <WhyIntro />

  <CompareStage />

  <Principle id={P2.id} n={2} title={`${P2.label}.`}
    text="Tickets, readings and photos are attached to the record they prove, not filed in a folder. Before you prepare a removal, noma shows what is still missing.">
    <EvidenceProof />
  </Principle>

  <Principle id={P3.id} n={3} title={`${P3.label}.`}
    text="noma is open source under the MIT licence. Every calculation it runs is code you, your team or your verifier can read, run and test.">
    <MathExcerpt />
  </Principle>

  <Principle id={P4.id} n={4} title={`${P4.label}.`}
    text="Run noma on your own servers, or let us host it for you. It is the same open-source code either way, and your records stay yours.">
    <Button slot="action" href={GITHUB_URL} variant="secondary" external>View on GitHub</Button>
    <Button slot="action" href="/get-started">Book a walkthrough</Button>
    <OwnershipProof />
  </Principle>

  <Principle id={P5.id} n={5} title={`${P5.label}.`} wide
    text="We’re building noma with Dark Earth Carbon in Mafinga, Tanzania, around the records a working plant keeps every day.">
    <Mafinga />
  </Principle>

  <GetStartedBand />
</SiteShell>

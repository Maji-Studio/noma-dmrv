---
// PROTOTYPE layout variant 12, "Apple hero, Vercel grid" (see src/variants/BRIEF.md).
// Idea: the page opens like Apple: an open, unframed, centred hero on the page ground with big type, and the chain trace
// large beneath it on the first screen. The trace panel is where the frame begins: its top hairline starts the full-height
// side rules and the ground switches from cream to white, so the change from open hero to framed body is one visible step.
// From there the body is Vercel's grid: split head cells, a bento for the features, cells for open source and the form.
// Section order is unchanged from variant 8. Copied helper: v12/Head.astro (new, own markup).
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Head from "../../variants/v12/Head.astro";
import BlockLink from "../../components/BlockLink.astro";
import LogoStrip from "../../components/LogoStrip.astro";
import FactLine from "../../components/FactLine.astro";
import VisualFrame from "../../components/VisualFrame.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import FeatureList from "../../components/FeatureList.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import OpenSourceOptions from "../../components/OpenSourceOptions.astro";
import WalkthroughForm from "../../components/WalkthroughForm.astro";
import { copy as c } from "../../content/copy.js";
---
<BaseLayout layout="12"
  title="noma, open-source biochar dMRV by MAJI"
  description="Trace every tonne of biochar, from feedstock to certification. Open-source digital monitoring, reporting and verification for biochar producers."
>
  <SiteHeader />
  <main id="main">
    <section class="open">
      <h1>{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="cta"><BlockLink href={c.cta.primaryHref}>{c.cta.primary}</BlockLink></div>
    </section>

    <div class="frame">
      <VisualFrame visual="chain" caption={c.captions.chain} />
      <div class="figs"><FactLine figures={c.proof.figures} /></div>
      <div class="logos"><LogoStrip label={c.proof.label} logos={c.proof.logos} /></div>

      <section class="sec" id="trace">
        <Head title={c.dense.title} lead={c.dense.lead} />
        <VisualFrame visual="dense" attrs={{ "data-jump": "true" }} caption={c.captions.dense} />
        <div class="shots">{c.dense.screenshots.map((s, i) => <ScreenshotFrame caption={s.caption} alt={s.alt} src={s.src} width={s.width} height={s.height} lead={i === 0} />)}</div>
      </section>

      <section class="sec">
        <Head title={c.map.title} lead={c.map.lead} />
        <VisualFrame visual="map" caption={c.captions.map} />
      </section>

      <section class="sec rose" id="features">
        <Head title={c.features.title} lead={c.features.lead} />
        <VisualFrame visual="bins" caption={c.captions.bins}>
          <Fragment slot="side">
            <h3 class="feat-title">{c.features.bins.title}</h3>
            <p>{c.features.bins.text}</p>
            <p class="hint">{c.features.bins.hint}</p>
          </Fragment>
        </VisualFrame>
        <FeatureList
          shipped={c.features.shipped} upcoming={c.features.upcoming} upcomingLabel={c.features.upcomingLabel}
          shippedHeading={c.features.shippedHeading} upcomingHeading={c.features.upcomingHeading}
        />
        <ComparisonTable title={c.compare.title} columns={c.compare.columns} rows={c.compare.rows} />
      </section>

      <section class="sec aside" id="registry">
        <Head title={c.registry.title} lead={c.registry.lead} stack />
        <VisualFrame visual="morph" caption={c.captions.morph} />
      </section>

      <section class="sec purple" id="open-source">
        <Head title={c.openSource.title} />
        <OpenSourceOptions cards={c.openSource.cards} />
      </section>

      <section class="sec aside" id="walkthrough">
        <Head title={c.walkthrough.title} lead={c.walkthrough.lead} stack />
        <div class="form-cell"><WalkthroughForm idPrefix="wt" /></div>
      </section>
      <SiteFooter />
    </div>
  </main>
</BaseLayout>
<style is:global>
  :root[data-layout="12"] {
    /* layout literals for this variant */
    --frame: 1600px;
    --edge: clamp(8px, 1.2vw, 20px);   /* page ground visible outside the frame rules */
    --gutter: clamp(20px, 3vw, 48px);
    --cell-space: clamp(36px, 4.4vw, 72px);
    --section-space: var(--cell-space);
    --prose: 52ch;                      /* about 71 characters of GT Flexa */
    --form: 720px;
    --fs-display: clamp(40px, 6vw, 104px);
    --fs-heading: clamp(30px, 3.6vw, 56px);
    --fs-lead: clamp(18px, 1.5vw, 21px);
    --viz-pad: 20px;
    --viz-max-h: 1000px;
    --side-width: calc(clamp(260px, 19vw, 320px) + var(--gutter));
  }
  :root[data-layout="12"] main p { max-width: min(100%, var(--prose)); }

  /* Open hero: no frame, no rules, centred, big type */
  :root[data-layout="12"] .open { display: grid; justify-items: center; gap: 16px; text-align: center; padding: clamp(28px, 3.4vw, 60px) var(--gutter) clamp(28px, 3vw, 48px); }
  :root[data-layout="12"] .open h1 { font-size: var(--fs-display); letter-spacing: var(--track-display); line-height: var(--lh-display); max-width: 26ch; }
  :root[data-layout="12"] .open .lead { font-size: var(--fs-lead); line-height: 1.5; }

  /* The frame opens at the trace: side rules run from here to the footer, the ground turns white */
  :root[data-layout="12"] .frame { width: min(var(--frame), 100% - var(--edge) * 2); margin-inline: auto; border-inline: var(--rule); border-top: var(--rule); background: var(--paper); min-width: 0; }
  :root[data-layout="12"] .frame > .vf { border-top: 0; }
  :root[data-layout="12"] .sec { min-width: 0; border-top: var(--rule); }
  :root[data-layout="12"] .sec.rose { background: var(--clr-rose-20); }
  :root[data-layout="12"] .sec.purple { background: var(--clr-purple-5); }
  :root[data-layout="12"] .figs { border-bottom: var(--rule); }
  :root[data-layout="12"] .figs .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  :root[data-layout="12"] .figs .fact { border-top: 0; padding: clamp(24px, 3vw, 40px) var(--gutter); justify-items: center; text-align: center; }
  :root[data-layout="12"] .figs .fact + .fact { border-left: var(--rule); }
  :root[data-layout="12"] .figs dd { max-width: 30ch; }
  :root[data-layout="12"] .figs mark { margin-left: 0; }
  :root[data-layout="12"] .logos { padding: clamp(28px, 3vw, 44px) var(--gutter); }
  @media (max-width: 640px) { :root[data-layout="12"] .figs .facts { grid-template-columns: 1fr; } :root[data-layout="12"] .figs .fact + .fact { border-left: 0; border-top: var(--rule); } }

  /* Split head cell: headline | lead */
  :root[data-layout="12"] .sh { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: stretch; }
  :root[data-layout="12"] .sh h2 { font-size: var(--fs-heading); letter-spacing: var(--track-heading); line-height: var(--lh-display); max-width: 18ch; padding: var(--cell-space) var(--gutter); }
  :root[data-layout="12"] .sh .lead { font-size: var(--fs-lead); line-height: 1.5; color: var(--clr-dark-purple-70); border-left: var(--rule); padding: var(--cell-space) var(--gutter); align-self: stretch; display: flex; align-items: flex-end; }
  :root[data-layout="12"] .sh.solo { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 860px) {
    :root[data-layout="12"] .sh { grid-template-columns: minmax(0, 1fr); }
    :root[data-layout="12"] .sh .lead { border-left: 0; border-top: var(--rule); padding-top: 24px; }
    :root[data-layout="12"] .sh h2 { padding-bottom: 24px; }
  }

  /* Aside sections (registry, form): head cell | content cell */
  :root[data-layout="12"] .sec.aside { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  :root[data-layout="12"] .aside .sh { grid-template-columns: minmax(0, 1fr); align-content: start; border-right: var(--rule); }
  :root[data-layout="12"] .aside .sh .lead { border-left: 0; border-top: var(--rule); align-items: flex-start; padding-block: 24px var(--cell-space); }
  :root[data-layout="12"] .aside .sh h2 { padding-bottom: 24px; }
  @media (max-width: 900px) {
    :root[data-layout="12"] .sec.aside { grid-template-columns: minmax(0, 1fr); }
    :root[data-layout="12"] .aside .sh { border-right: 0; border-bottom: var(--rule); }
  }

  /* Visuals fill their cells; the trace panel stays beside the diagram */
  :root[data-layout="12"] .vf { margin: 0; border: 0; border-top: var(--rule); }
  :root[data-layout="12"] .aside .vf { border-top: 0; align-self: start; }
  :root[data-layout="12"] .vf.has-side { grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.7fr); }
  :root[data-layout="12"] .vf figcaption { padding-inline: var(--gutter); }
  :root[data-layout="12"] .vf.has-side .side { padding: var(--cell-space) var(--gutter); }
  :root[data-layout="12"] .feat-title { font-size: var(--fs-subheading); letter-spacing: -0.035em; }
  :root[data-layout="12"] .hint { font-size: var(--fs-small); color: var(--clr-dark-purple-70); }
  @media (max-width: 900px) { :root[data-layout="12"] .vf.has-side { grid-template-columns: minmax(0, 1fr); } }

  :root[data-layout="12"] .shots { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--gutter); padding: var(--gutter); align-items: start; border-top: var(--rule); }
  :root[data-layout="12"] .shots > .lead { grid-row: 1 / span 2; }
  @media (max-width: 900px) { :root[data-layout="12"] .shots { grid-template-columns: minmax(0, 1fr); } :root[data-layout="12"] .shots > .lead { grid-row: auto; } }

  /* Features as a bento on six columns. Rows: 4+2, 2+4, 2+2+2, 3+3. Wide cells set the icon and title beside the text so no cell is half empty. */
  :root[data-layout="12"] .features { gap: 0; background: var(--paper); }
  :root[data-layout="12"] .features .group-title { margin: 0; padding: 24px var(--gutter); border-top: var(--rule); }
  :root[data-layout="12"] .features .grid { border: 0; border-top: var(--rule); }
  :root[data-layout="12"] .features li { padding: 28px var(--gutter) 36px; }
  :root[data-layout="12"] .features .shipped, :root[data-layout="12"] .features .upcoming { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  :root[data-layout="12"] .features .shipped li { grid-column: span 2; }
  :root[data-layout="12"] .features .shipped li:is(:nth-child(1), :nth-child(4)) { grid-column: span 4; }
  :root[data-layout="12"] .features .shipped li:is(:nth-child(8), :nth-child(9)) { grid-column: span 3; }
  :root[data-layout="12"] .features .shipped li:is(:nth-child(1), :nth-child(4)) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gutter); align-content: center; }
  :root[data-layout="12"] .features .shipped li:is(:nth-child(1), :nth-child(4)) > :is(svg, h4) { grid-column: 1; }
  :root[data-layout="12"] .features .shipped li:is(:nth-child(1), :nth-child(4)) > p { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  :root[data-layout="12"] .features .upcoming li { grid-column: span 2; }
  :root[data-layout="12"] .features .upcoming li:nth-child(n+4) { grid-column: span 3; }
  @media (max-width: 900px) {
    :root[data-layout="12"] .features .shipped, :root[data-layout="12"] .features .upcoming { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :root[data-layout="12"] .features .shipped li, :root[data-layout="12"] .features .shipped li:nth-child(n), :root[data-layout="12"] .features .upcoming li, :root[data-layout="12"] .features .upcoming li:nth-child(n) { grid-column: auto; display: grid; grid-template-columns: minmax(0, 1fr); }
    :root[data-layout="12"] .features .shipped li > p, :root[data-layout="12"] .features .shipped li:nth-child(n) > p { grid-column: auto; grid-row: auto; }
    :root[data-layout="12"] .features .upcoming li:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) { :root[data-layout="12"] .features .shipped, :root[data-layout="12"] .features .upcoming { grid-template-columns: 1fr; } }
  :root[data-layout="12"] .compare { gap: 0; margin: 0; border-top: var(--rule); }
  :root[data-layout="12"] .compare h3 { padding: 24px var(--gutter); border-bottom: var(--rule); }
  :root[data-layout="12"] .compare .scroll { border: 0; }
  :root[data-layout="12"] .compare :is(th, td) { padding-inline: var(--gutter); }

  :root[data-layout="12"] .options { gap: 0; border-top: var(--rule); }
  :root[data-layout="12"] .option { border: 0; padding: var(--cell-space) var(--gutter); background: transparent; }
  :root[data-layout="12"] .option + .option { border-left: var(--rule); }
  @media (max-width: 700px) { :root[data-layout="12"] .option + .option { border-left: 0; border-top: var(--rule); } }

  :root[data-layout="12"] .form-cell { padding: var(--gutter); }
  :root[data-layout="12"] .form-cell .wt-form { max-width: var(--form); }
  :root[data-layout="12"] .foot .row { margin-inline: calc(var(--gutter) * -1); }
</style>

---
// PROTOTYPE layout variant 8, "Vercel style" (see src/variants/BRIEF.md): hairline frame, cells, bento.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Hero from "../../variants/v8/Hero.astro";
import Section from "../../components/Section.astro";
import VisualFrame from "../../components/VisualFrame.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import FeatureList from "../../components/FeatureList.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import OpenSourceOptions from "../../components/OpenSourceOptions.astro";
import WalkthroughForm from "../../components/WalkthroughForm.astro";
import { copy as c } from "../../content/copy.js";
import "../../variants/measure-cap.css";
---
<BaseLayout layout="8"
  title="noma, open-source biochar dMRV by MAJI"
  description="Trace every tonne of biochar, from feedstock to certification. Open-source digital monitoring, reporting and verification for biochar producers."
>
  <SiteHeader />
  <main id="main">
    <Hero />

    <Section id="trace" band="purple" title={c.dense.title} lead={c.dense.lead} split>
      <VisualFrame visual="dense" attrs={{ "data-jump": "true" }} caption={c.captions.dense} />
      <div class="shots">{c.dense.screenshots.map((s, i) => <ScreenshotFrame caption={s.caption} alt={s.alt} src={s.src} width={s.width} height={s.height} lead={i === 0} />)}</div>
    </Section>

    <Section title={c.map.title} lead={c.map.lead} split>
      <VisualFrame visual="map" caption={c.captions.map} />
    </Section>

    <Section id="features" band="rose" title={c.features.title} lead={c.features.lead} split>
      <VisualFrame visual="bins" caption={c.captions.bins}>
        <Fragment slot="side">
          <h3 class="feat-title">{c.features.bins.title}</h3>
          <p>{c.features.bins.text}</p>
          <p class="hint">{c.features.bins.hint}</p>
        </Fragment>
      </VisualFrame>
      <FeatureList
        shipped={c.features.shipped} upcoming={c.features.upcoming} upcomingLabel={c.features.upcomingLabel}
        shippedHeading={c.features.shippedHeading} upcomingHeading={c.features.upcomingHeading}
      />
      <ComparisonTable title={c.compare.title} columns={c.compare.columns} rows={c.compare.rows} />
    </Section>

    <Section id="registry" title={c.registry.title} lead={c.registry.lead} aside>
      <VisualFrame visual="morph" caption={c.captions.morph} />
    </Section>

    <Section id="open-source" band="purple" title={c.openSource.title}>
      <OpenSourceOptions cards={c.openSource.cards} />
    </Section>

    <Section id="walkthrough" title={c.walkthrough.title} lead={c.walkthrough.lead} aside>
      <WalkthroughForm idPrefix="wt" />
    </Section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .shots { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); column-gap: clamp(24px, 3vw, 48px); row-gap: clamp(24px, 3vw, 40px); align-items: start; padding: var(--section-space) var(--gutter); }
  .shots > :global(.lead) { grid-row: 1 / span 2; }
  @media (max-width: 900px) { .shots { grid-template-columns: 1fr; } .shots > :global(.lead) { grid-row: auto; } }
  .feat-title { font-size: var(--fs-subheading); letter-spacing: -0.035em; }
  .hint { font-size: var(--fs-small); color: var(--clr-dark-purple-70); }
  .feat-title + p { font-size: var(--fs-body); max-width: 44ch; }
</style>
<style is:global>
  :root[data-layout="8"] {
    --frame: 1600px;
    --edge: 24px;               /* clear space between the frame rules and the viewport edge */
    --viz-pad: 20px;
    --side-width: 270px;
    --gutter: clamp(20px, 3vw, 40px);
    --section-space: clamp(48px, 5vw, 80px);
    --col-gap: clamp(24px, 4vw, 64px);
    --fs-display: clamp(40px, 4.6vw, 72px);
    --fs-heading: clamp(30px, 3.8vw, 56px);
    --measure: 60ch;
  }
  @media (max-width: 700px) { :root[data-layout="8"] { --edge: 12px; } }
  /* The frame: the whole page is one bounded column whose side edges are hairlines running the full page height. */
  :root[data-layout="8"] body { width: min(var(--frame), calc(100% - var(--edge) * 2)); margin-inline: auto; border-inline: var(--rule); }
  :root[data-layout="8"] .section { border-top: var(--rule) !important; }
  :root[data-layout="8"] main .inner { padding: 0; gap: 0; }
  :root[data-layout="8"] main .head { padding: var(--section-space) var(--gutter); }
  :root[data-layout="8"] main .head:not(:last-child) { border-bottom: var(--rule); }
  :root[data-layout="8"] .head.split { column-gap: var(--col-gap); }
  /* Visuals fill their cells edge to edge. */
  :root[data-layout="8"] .vf { margin: 0 !important; border: 0 !important; border-bottom: var(--rule) !important; }
  :root[data-layout="8"] .vf.has-side .side { padding: var(--section-space) var(--gutter); }
  /* Aside sections: heading cell | content cell, one vertical hairline between. */
  :root[data-layout="8"] .inner.aside { column-gap: 0; align-items: stretch; }
  :root[data-layout="8"] .aside .head { border-bottom: 0 !important; border-right: var(--rule); align-self: stretch; align-content: start; }
  :root[data-layout="8"] .aside > :not(.head) { border-bottom: 0 !important; }
  :root[data-layout="8"] .aside .wt-form { border: 0; padding: var(--section-space) var(--gutter); }
  @media (max-width: 860px) {
    :root[data-layout="8"] .aside .head { border-right: 0; border-bottom: var(--rule) !important; }
  }
  /* Features as a bento of bordered cells. */
  :root[data-layout="8"] .features { gap: 0; }
  :root[data-layout="8"] .features .group-title { margin: 0; padding: 24px var(--gutter); }
  :root[data-layout="8"] .features .grid { border: 0; border-block: var(--rule); }
  :root[data-layout="8"] .features .shipped { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  :root[data-layout="8"] .features li { padding: 28px var(--gutter) 40px; }
  @media (max-width: 900px) { :root[data-layout="8"] .features .shipped { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { :root[data-layout="8"] .features .shipped { grid-template-columns: 1fr; } }
  :root[data-layout="8"] .compare { gap: 0; margin: 0; }
  :root[data-layout="8"] .compare h3 { padding: 24px var(--gutter); }
  :root[data-layout="8"] .compare .scroll { border: 0; border-top: var(--rule); }
  :root[data-layout="8"] .compare :is(th, td) { padding-inline: var(--gutter); }
  :root[data-layout="8"] .options { gap: 0; }
  :root[data-layout="8"] .option { border: 0; padding: var(--section-space) var(--gutter); }
  :root[data-layout="8"] .option + .option { border-left: var(--rule); }
  @media (max-width: 700px) { :root[data-layout="8"] .option + .option { border-left: 0; border-top: var(--rule); } }
  :root[data-layout="8"] .foot .row { margin-inline: calc(var(--gutter) * -1); }
</style>

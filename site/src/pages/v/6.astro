---
// PROTOTYPE layout variant 6, "Apple style" (see src/variants/BRIEF.md).
// Idea: one idea per screen. Every section is a full-width band with a centred headline on a short measure and a
// centred lead, then the visual presented large and centred underneath, wider than the text (up to 1760px). The trace's
// "How to read it" panel stays inside the visual's own frame, beside the diagram, so it travels with it.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BlockLink from "../../components/BlockLink.astro";
import LogoStrip from "../../components/LogoStrip.astro";
import FactLine from "../../components/FactLine.astro";
import VisualFrame from "../../components/VisualFrame.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import FeatureList from "../../components/FeatureList.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import OpenSourceOptions from "../../components/OpenSourceOptions.astro";
import WalkthroughForm from "../../components/WalkthroughForm.astro";
import { copy as c } from "../../content/copy.js";
const LONG_LEAD = 100; // characters; longer leads are set left-aligned in a centred column
const lc = (t: string) => (t.length > LONG_LEAD ? "lead long" : "lead");
---
<BaseLayout layout="6"
  title="noma, open-source biochar dMRV by MAJI"
  description="Trace every tonne of biochar, from feedstock to certification. Open-source digital monitoring, reporting and verification for biochar producers."
>
  <SiteHeader />
  <main id="main">
    <section class="band hero">
      <div class="head">
        <h1>{c.hero.title}</h1>
        <p class={lc(c.hero.lead)}>{c.hero.lead}</p>
        <div class="cta"><BlockLink href={c.cta.primaryHref}>{c.cta.primary}</BlockLink></div>
      </div>
      <div class="wrap"><VisualFrame visual="chain" caption={c.captions.chain} /></div>
      <div class="wrap narrow proof"><FactLine figures={c.proof.figures} /></div>
      <div class="wrap narrow"><LogoStrip label={c.proof.label} logos={c.proof.logos} /></div>
    </section>

    <section class="band paper" id="trace">
      <header class="head"><h2>{c.dense.title}</h2><p class={lc(c.dense.lead)}>{c.dense.lead}</p></header>
      <div class="wrap dense"><VisualFrame visual="dense" attrs={{ "data-jump": "true" }} caption={c.captions.dense} /></div>
      <div class="wrap shots">{c.dense.screenshots.map((s, i) => <ScreenshotFrame caption={s.caption} alt={s.alt} src={s.src} width={s.width} height={s.height} lead={i === 0} />)}</div>
    </section>

    <section class="band">
      <header class="head"><h2>{c.map.title}</h2><p class={lc(c.map.lead)}>{c.map.lead}</p></header>
      <div class="wrap"><VisualFrame visual="map" caption={c.captions.map} /></div>
    </section>

    <section class="band rose" id="features">
      <header class="head"><h2>{c.features.title}</h2><p class={lc(c.features.lead)}>{c.features.lead}</p></header>
      <div class="wrap">
        <VisualFrame visual="bins" caption={c.captions.bins}>
          <Fragment slot="side">
            <h3 class="feat-title">{c.features.bins.title}</h3>
            <p>{c.features.bins.text}</p>
            <p class="hint">{c.features.bins.hint}</p>
          </Fragment>
        </VisualFrame>
      </div>
      <div class="wrap tiles">
        <FeatureList
          shipped={c.features.shipped} upcoming={c.features.upcoming} upcomingLabel={c.features.upcomingLabel}
          shippedHeading={c.features.shippedHeading} upcomingHeading={c.features.upcomingHeading}
        />
      </div>
      <div class="wrap narrow compare-wrap">
        <ComparisonTable title={c.compare.title} columns={c.compare.columns} rows={c.compare.rows} />
      </div>
    </section>

    <section class="band paper" id="registry">
      <header class="head"><h2>{c.registry.title}</h2><p class={lc(c.registry.lead)}>{c.registry.lead}</p></header>
      <div class="wrap narrow"><VisualFrame visual="morph" caption={c.captions.morph} /></div>
    </section>

    <section class="band purple" id="open-source">
      <header class="head"><h2>{c.openSource.title}</h2></header>
      <div class="wrap narrow"><OpenSourceOptions cards={c.openSource.cards} /></div>
    </section>

    <section class="band" id="walkthrough">
      <header class="head"><h2>{c.walkthrough.title}</h2><p class={lc(c.walkthrough.lead)}>{c.walkthrough.lead}</p></header>
      <div class="wrap form"><WalkthroughForm idPrefix="wt" /></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style is:global>
  :root[data-layout="6"] {
    /* layout literals for this variant */
    --wide: 1440px;            /* visuals: capped so the trace panel stays close to its diagram */
    --mid: 1240px;             /* tables, cards, facts */
    --form: 760px;
    --headline: 20ch;          /* short measure for big headlines */
    --lead-measure: 42ch;      /* about 60 characters at the lead size */
    --band-space: clamp(48px, 5.5vw, 104px);
    --stack: clamp(28px, 3vw, 56px);
    --gutter: clamp(20px, 2.5vw, 48px);
    --viz-max-h: 1100px;
    --viz-pad: 20px;
    --side-width: 270px;
    --fs-h1: clamp(44px, 5vw, 80px);
    --fs-h2: clamp(34px, 4vw, 64px);
  }
  :root[data-layout="6"] .band { display: grid; justify-items: center; gap: var(--stack); padding: var(--band-space) var(--gutter); }
  :root[data-layout="6"] .band.hero { padding-top: clamp(32px, 3.4vw, 64px); }
  :root[data-layout="6"] .band.paper { background: var(--paper); }
  :root[data-layout="6"] .band.rose { background: var(--clr-rose-20); }
  :root[data-layout="6"] .band.purple { background: var(--clr-purple-5); }
  :root[data-layout="6"] .band > * { min-width: 0; }

  :root[data-layout="6"] .head { display: grid; justify-items: center; gap: 20px; text-align: center; width: 100%; }
  :root[data-layout="6"] .head h1 { font-size: var(--fs-h1); letter-spacing: var(--track-display); line-height: var(--lh-display); max-width: var(--headline); }
  :root[data-layout="6"] .head h2 { font-size: var(--fs-h2); letter-spacing: var(--track-display); line-height: var(--lh-display); max-width: var(--headline); }
  :root[data-layout="6"] .head .lead { font-size: clamp(19px, 1.5vw, 26px); line-height: 1.5; max-width: var(--lead-measure); color: var(--clr-dark-purple-70); }
  :root[data-layout="6"] .head .lead.long { text-align: left; }
  :root[data-layout="6"] .hero .head .lead { color: var(--ink); }
  :root[data-layout="6"] .cta { display: flex; justify-content: center; margin-top: 8px; }

  /* Visuals: large and centred, wider than the text. Local gutter is the frame's inner padding. */
  :root[data-layout="6"] .wrap { --gutter: 24px; width: 100%; max-width: var(--wide); min-width: 0; }
  :root[data-layout="6"] .wrap.narrow { max-width: var(--mid); }
  :root[data-layout="6"] .wrap.form { max-width: var(--form); }
  :root[data-layout="6"] .wrap .vf { margin-inline: 0; border: var(--panel-border); }
  :root[data-layout="6"] .wrap .vf.has-side { grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.6fr); }
  :root[data-layout="6"] .feat-title { font-size: var(--fs-subheading); letter-spacing: -0.035em; }
  :root[data-layout="6"] .hint { font-size: var(--fs-small); color: var(--clr-dark-purple-70); }
  :root[data-layout="6"] .feat-title + p { font-size: var(--fs-body); max-width: 44ch; }
  :root[data-layout="6"] .shots { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); column-gap: clamp(24px, 3vw, 48px); row-gap: clamp(24px, 3vw, 40px); align-items: start; }
  :root[data-layout="6"] .shots > .lead { grid-row: 1 / span 2; }

  /* Figures as two tiles, proof logos as one centred row */
  :root[data-layout="6"] .proof .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  :root[data-layout="6"] .proof .facts { grid-auto-rows: 1fr; }
  :root[data-layout="6"] .proof .fact { border: var(--panel-border); background: var(--paper); padding: clamp(20px, 2.4vw, 36px); justify-items: center; align-content: start; text-align: center; }
  :root[data-layout="6"] .proof dt { min-height: 1.2em; display: flex; align-items: center; justify-content: center; }
  :root[data-layout="6"] .proof mark { margin-left: 0; }
  :root[data-layout="6"] .proof dd { max-width: 30ch; }
  :root[data-layout="6"] .strip { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; row-gap: 24px; }
  :root[data-layout="6"] .strip .logos { width: 100%; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }

  /* Features as a tidy grid of tiles */
  :root[data-layout="6"] .tiles { max-width: var(--wide); }
  :root[data-layout="6"] .shots { gap: 24px; }
  :root[data-layout="6"] .features { gap: 24px; }
  :root[data-layout="6"] .features .group-title { text-align: center; margin-top: var(--stack); font-size: clamp(28px, 3vw, 44px); }
  :root[data-layout="6"] .features .group-title:first-child { margin-top: 0; }
  :root[data-layout="6"] .features .grid { gap: 16px; background: transparent; border: 0; }
  :root[data-layout="6"] .features .grid li { border: var(--panel-border); }
  :root[data-layout="6"] .features .upcoming { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  :root[data-layout="6"] .compare-wrap .compare { margin-top: 0; }
  :root[data-layout="6"] .compare-wrap h3 { text-align: center; font-size: clamp(28px, 3vw, 44px); }

  @media (max-width: 1100px) { :root[data-layout="6"] .features .shipped { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) { :root[data-layout="6"] .wrap .vf.has-side { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 700px) {
    :root[data-layout="6"] { --gutter: 20px; }
    :root[data-layout="6"] .wrap { --gutter: 20px; }
    :root[data-layout="6"] .shots { grid-template-columns: minmax(0, 1fr); }
    :root[data-layout="6"] .shots > .lead { grid-row: auto; }
    :root[data-layout="6"] .proof .facts { grid-template-columns: minmax(0, 1fr); }
    :root[data-layout="6"] .features .shipped { grid-template-columns: minmax(0, 1fr); }
  }
</style>

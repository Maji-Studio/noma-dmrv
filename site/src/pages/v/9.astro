---
// PROTOTYPE layout variant 9, "Linear style" (see src/variants/BRIEF.md).
// One 1240px container. Tight left-aligned hero, then the chain trace as a product frame. Sections open with a stacked
// heading and lead; features and the comparison table are dense with hairline separators. No full-bleed bands.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VisualFrame from "../../components/VisualFrame.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import FeatureList from "../../components/FeatureList.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import OpenSourceOptions from "../../components/OpenSourceOptions.astro";
import WalkthroughForm from "../../components/WalkthroughForm.astro";
import BlockLink from "../../components/BlockLink.astro";
import LogoStrip from "../../components/LogoStrip.astro";
import FactLine from "../../components/FactLine.astro";
import { copy as c } from "../../content/copy.js";
import "../../variants/measure-cap.css";
---
<BaseLayout layout="9"
  title="noma, open-source biochar dMRV by MAJI"
  description="Trace every tonne of biochar, from feedstock to certification. Open-source digital monitoring, reporting and verification for biochar producers."
>
  <SiteHeader />
  <main id="main">
    <section class="v9-hero">
      <div class="v9-wrap">
        <h1>{c.hero.title}</h1>
        <p class="lead">{c.hero.lead}</p>
        <div class="v9-cta"><BlockLink href={c.cta.primaryHref}>{c.cta.primary}</BlockLink></div>
        <div class="v9-pf v9-hero-frame"><VisualFrame visual="chain" caption={c.captions.chain} /></div>
        <div class="v9-proof">
          <FactLine figures={c.proof.figures} />
          <LogoStrip label={c.proof.label} logos={c.proof.logos} />
        </div>
      </div>
    </section>

    <section class="v9-sec" id="trace">
      <div class="v9-wrap">
        <header class="v9-head"><h2>{c.dense.title}</h2><p class="lead">{c.dense.lead}</p></header>
        <div class="v9-pf"><VisualFrame visual="dense" attrs={{ "data-jump": "true", "data-side": "below" }} caption={c.captions.dense} /></div>
        <div class="v9-shots">{c.dense.screenshots.map((s) => <ScreenshotFrame caption={s.caption} alt={s.alt} src={s.src} width={s.width} height={s.height} />)}</div>
      </div>
    </section>

    <section class="v9-sec">
      <div class="v9-wrap">
        <header class="v9-head"><h2>{c.map.title}</h2><p class="lead">{c.map.lead}</p></header>
        <div class="v9-pf"><VisualFrame visual="map" caption={c.captions.map} /></div>
      </div>
    </section>

    <section class="v9-sec" id="features">
      <div class="v9-wrap">
        <header class="v9-head"><h2>{c.features.title}</h2><p class="lead">{c.features.lead}</p></header>
        <div class="v9-pf">
          <VisualFrame visual="bins" caption={c.captions.bins}>
            <Fragment slot="side">
              <h3 class="v9-feat-title">{c.features.bins.title}</h3>
              <p>{c.features.bins.text}</p>
              <p class="v9-hint">{c.features.bins.hint}</p>
            </Fragment>
          </VisualFrame>
        </div>
        <div class="v9-dense">
          <FeatureList
            shipped={c.features.shipped} upcoming={c.features.upcoming} upcomingLabel={c.features.upcomingLabel}
            shippedHeading={c.features.shippedHeading} upcomingHeading={c.features.upcomingHeading}
          />
          <ComparisonTable title={c.compare.title} columns={c.compare.columns} rows={c.compare.rows} />
        </div>
      </div>
    </section>

    <section class="v9-sec" id="registry">
      <div class="v9-wrap">
        <header class="v9-head"><h2>{c.registry.title}</h2><p class="lead">{c.registry.lead}</p></header>
        <div class="v9-pf"><VisualFrame visual="morph" caption={c.captions.morph} /></div>
      </div>
    </section>

    <section class="v9-sec" id="open-source">
      <div class="v9-wrap">
        <header class="v9-head"><h2>{c.openSource.title}</h2></header>
        <OpenSourceOptions cards={c.openSource.cards} />
      </div>
    </section>

    <section class="v9-sec" id="walkthrough">
      <div class="v9-wrap">
        <header class="v9-head"><h2>{c.walkthrough.title}</h2><p class="lead">{c.walkthrough.lead}</p></header>
        <div class="v9-form"><WalkthroughForm idPrefix="wt" /></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style is:global>
  :root[data-layout="9"] {
    --wrap: 1240px;
    --pad: clamp(20px, 3.4vw, 40px);
    --gutter: var(--pad);
    --section-space: clamp(56px, 6vw, 104px);
    --col-gap: clamp(20px, 3vw, 40px);
    --measure: 58ch;
    --viz-pad: 20px;
    --viz-max-h: 760px;
    --cell-pad: 20px;
    --table-pad: 16px;
    --v9-h1: clamp(40px, 4.8vw, 68px);
    --v9-h2: clamp(28px, 2.8vw, 40px);
    --v9-hero-measure: 17ch;
    --v9-head-gap: 14px;
    --v9-block-gap: 28px;
    --v9-frame-gutter: 20px;
    --v9-frame-side: clamp(250px, 24vw, 300px);
  }
  /* one edge system: header, sections and footer all end on the same container */
  :root[data-layout="9"] .bar,
  :root[data-layout="9"] .foot .inner { max-width: calc(var(--wrap) + 2 * var(--pad)); margin-inline: auto; }
  :root[data-layout="9"] .v9-wrap { max-width: calc(var(--wrap) + 2 * var(--pad)); margin-inline: auto; padding-inline: var(--pad); display: grid; gap: var(--v9-block-gap); }

  :root[data-layout="9"] .v9-hero { padding-block: clamp(32px, 5vw, 80px) clamp(40px, 5vw, 72px); }
  :root[data-layout="9"] .v9-hero .v9-wrap { gap: 20px; justify-items: start; }
  :root[data-layout="9"] .v9-hero h1 { font-size: var(--v9-h1); letter-spacing: var(--track-display); line-height: var(--lh-display); max-width: var(--v9-hero-measure); }
  :root[data-layout="9"] .v9-hero .lead { font-size: var(--fs-lead); line-height: 1.5; max-width: 52ch; color: var(--clr-dark-purple-70); }
  :root[data-layout="9"] .v9-cta { margin-bottom: clamp(12px, 3vw, 40px); }
  :root[data-layout="9"] .v9-hero-frame { width: 100%; }
  :root[data-layout="9"] .v9-proof { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 24px var(--col-gap); align-items: start; margin-top: 12px; }
  :root[data-layout="9"] .v9-proof .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; }
  :root[data-layout="9"] .v9-proof .fact { padding-block: 14px 0; }
  :root[data-layout="9"] .v9-proof dt { font-size: clamp(28px, 2.6vw, 36px); }
  :root[data-layout="9"] .v9-proof .strip { grid-template-columns: 1fr; row-gap: 12px; padding-top: 14px; border-top: var(--rule); }
  :root[data-layout="9"] .v9-proof .logos { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }
  :root[data-layout="9"] .v9-proof .ph { min-height: 56px; font-size: 16px; padding: 8px 12px; }
  @media (max-width: 900px) { :root[data-layout="9"] .v9-proof { grid-template-columns: 1fr; } }

  :root[data-layout="9"] .v9-sec { padding-top: var(--section-space); }
  :root[data-layout="9"] .v9-sec:last-of-type { padding-bottom: var(--section-space); }
  :root[data-layout="9"] .v9-sec > .v9-wrap::before { content: ""; border-top: var(--rule); margin-bottom: calc(clamp(20px, 2vw, 28px) - var(--v9-block-gap)); }
  :root[data-layout="9"] .foot { border-top: 0; }
  :root[data-layout="9"] .v9-head { display: grid; gap: var(--v9-head-gap); margin-bottom: 4px; }
  :root[data-layout="9"] .v9-head h2 { font-size: var(--v9-h2); letter-spacing: -0.04em; line-height: 1.08; max-width: 22ch; }
  :root[data-layout="9"] .v9-head .lead { font-size: var(--fs-lead); line-height: 1.5; max-width: var(--measure); color: var(--clr-dark-purple-70); }

  /* product frames: boxed on all four sides, panel padding local to the frame */
  :root[data-layout="9"] .v9-pf { --gutter: var(--v9-frame-gutter); --side-width: var(--v9-frame-side); min-width: 0; }
  :root[data-layout="9"] .v9-pf .vf { margin-inline: 0; border: var(--panel-border); }
  :root[data-layout="9"] .v9-pf .vf.has-side { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.5fr); }
  :root[data-layout="9"] .v9-pf .side { padding: 24px; gap: 12px; }
  :root[data-layout="9"] .v9-pf .side p { font-size: var(--fs-small); line-height: 1.5; }
  :root[data-layout="9"] .v9-feat-title { font-size: 22px; letter-spacing: -0.03em; }
  :root[data-layout="9"] .v9-hint { font-size: var(--fs-fine); color: var(--clr-dark-purple-70); }
  :root[data-layout="9"] .v9-pf .nv-scroll-hint { padding-inline: var(--v9-frame-gutter); }

  :root[data-layout="9"] .v9-shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px var(--col-gap); align-items: start; }
  :root[data-layout="9"] .v9-shots .shot { gap: 8px; }
  :root[data-layout="9"] .v9-shots figcaption { font-size: var(--fs-small); }
  @media (max-width: 860px) { :root[data-layout="9"] .v9-shots { grid-template-columns: 1fr; } }

  /* dense features and comparison */
  :root[data-layout="9"] .v9-dense { display: grid; gap: 40px; }
  :root[data-layout="9"] .v9-dense .features { gap: 12px; }
  :root[data-layout="9"] .v9-dense .group-title { font-size: 22px; margin-top: 16px; }
  :root[data-layout="9"] .v9-dense .group-title:first-child { margin-top: 0; }
  :root[data-layout="9"] .v9-dense .features li { padding: 20px var(--cell-pad) 24px; gap: 6px; }
  :root[data-layout="9"] .v9-dense .features h4 { font-size: 19px; }
  :root[data-layout="9"] .v9-dense .features p { font-size: var(--fs-small); line-height: 1.5; }
  :root[data-layout="9"] .v9-dense .features .upcoming { grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  :root[data-layout="9"] .v9-dense .compare { margin-top: 0; gap: 12px; }
  :root[data-layout="9"] .v9-dense .compare h3 { font-size: 22px; }
  :root[data-layout="9"] .v9-dense .compare table { font-size: var(--fs-small); }
  :root[data-layout="9"] .v9-dense .compare thead th { padding-block: 10px; }
  :root[data-layout="9"] .v9-dense .compare tbody th, :root[data-layout="9"] .v9-dense .compare td { padding-block: 12px; }

  :root[data-layout="9"] .options { gap: 16px; }
  :root[data-layout="9"] .option { padding: 24px; gap: 10px; }
  :root[data-layout="9"] .option h3 { font-size: 24px; }
  :root[data-layout="9"] .option .text { font-size: var(--fs-body); }
  :root[data-layout="9"] .v9-form { max-width: 720px; }
</style>

---
import Shell from '../../components/preview/preview-shell.astro';
import Trace from '../../components/preview/trace-preview.astro';
import Upcoming from '../../components/preview/upcoming-preview.astro';
import WalkthroughForm from '../../components/WalkthroughForm.astro';
const upcoming = [
  {kind:'documents', title:'Read documents into records.', text:'Use weighbridge tickets and lab reports to fill in records, ready for your review.'},
  {kind:'reactor', title:'Bring in reactor readings.', text:'Record temperature and energy data from your reactor without entering each reading by hand.'},
  {kind:'telegram', title:'Record work through Telegram.', text:'Log deliveries, production runs and readings from a chat.'},
  {kind:'connections', title:'Connect your other tools.', text:'Use an open API and MCP to work with noma’s records from other software and AI tools.'},
  {kind:'checks', title:'Catch unusual readings earlier.', text:'Use AI checks to flag values that need a closer look before reporting.'},
];
---
<Shell>
  <section class="pv-hero pv-wrap">
    <div><p class="pv-category">Biochar MRV software</p><h1>Trace your biochar, <br/>from feedstock <br/>to application.</h1></div>
    <div class="pv-hero-lead"><p>See where it came from, what happened during production, and where it went.</p><p class="pv-muted">noma connects your material records and supporting evidence, in both directions.</p><a href="#walkthrough" class="pv-button">Book a walkthrough</a></div>
  </section>
  <div class="pv-wrap"><Trace /></div>
  <section class="pv-follow pv-wrap">
    <h2>Follow the material.<br/>Find the evidence.</h2>
    <div><p>Trace an application back to its sources, or see where a production run’s biochar ended up. Follow the connections through storage, mixing and delivery.</p><a href="/preview/product" class="pv-link">Explore the product <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="pv-reporting pv-wrap">
    <div class="pv-section-copy"><h2>The same records.<br/>Ready for reporting.</h2><p>Keep production records, transport documents and lab results connected. See what information is missing as you prepare your registry submission.</p><a class="pv-link" href="/preview/product#reporting">See how records connect</a></div>
    <div class="pv-evidence-panel"><div class="pv-panel-bar"><strong>Evidence review</strong><span>Example records</span></div><h3>See what needs attention.</h3><div class="pv-evidence-row"><span>Production measurements<small>Production run PR-001</small></span><b class="pv-check">Recorded</b></div><div class="pv-evidence-row"><span>Transport evidence<small>Delivery DL-001</small></span><b class="pv-attention">File missing</b></div><div class="pv-evidence-row"><span>Lab results<small>Credit batch CB-001</small></span><b class="pv-check">Recorded</b></div><p class="pv-panel-foot">Return to the record behind each figure.</p></div>
  </section>
  <section class="pv-producer pv-wrap" id="producers">
    <figure><img src="/preview/mafinga-field-trial.jpg" alt="Field trial plots in Mafinga, Tanzania" width="1400" height="933" loading="lazy"/><figcaption>Mafinga, Tanzania</figcaption></figure>
    <div class="pv-section-copy"><h2>Built with<br/>biochar producers.</h2><p>We’re developing noma with Dark Earth Carbon in Mafinga, Tanzania, around the work of recording production and tracing biochar to its application.</p><p class="pv-muted">The starting point is the work on the ground.</p></div>
  </section>
  <section class="pv-next pv-wrap" id="next">
    <div class="pv-next-heading"><h2>What we’re building next.</h2><p>Less manual work. <br/>More connected records.</p></div>
    {upcoming.map((item) => <section class="pv-future-row" aria-label={item.title}><div class="pv-section-copy"><span class="pv-upcoming">Upcoming</span><h3>{item.title}</h3><p>{item.text}</p></div><Upcoming kind={item.kind}/></section>)}
    <p class="pv-roadmap-note">These features are planned. The previews illustrate how they could work.</p>
  </section>
  <section class="pv-open pv-wrap"><div><h2>Open source.<br/>Yours to inspect and run.</h2><p>Review the code and calculations. Host noma yourself, or talk to us about managed hosting.</p></div><div class="pv-open-actions"><a class="pv-button" href="/preview/open-source">Explore open source</a><a href="https://github.com/Maji-Studio/noma-dmrv" class="pv-link">View on GitHub ↗</a></div></section>
  <section class="pv-contact pv-wrap" id="walkthrough"><div><h2>Follow your<br/>biochar with us.</h2><p>We’ll walk through the trace and the records behind it, using an example like your operation.</p><span class="pv-muted">Preview only. This form does not send a request.</span></div><WalkthroughForm idPrefix="preview" /></section>
</Shell>

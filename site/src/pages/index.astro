---
// The noma landing page (docs/plans/2026-09-29-landing-page.md): one long editorial page, trace in the hero.
import "../styles/tokens.css";
import "../visuals/visuals.css";
import { copy } from "../content/copy.js";
import { featIcon } from "../visuals/core.js";
import WalkthroughForm from "../components/WalkthroughForm.astro";
const c = copy;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>noma, open-source biochar dMRV by MAJI</title>
    <meta name="description" content="Trace every tonne of biochar, from feedstock to certification. Open-source digital monitoring, reporting and verification for biochar producers." />
  </head>
  <body>
<div class="va">
  <nav class="va-nav" aria-label="Main">
    <span class="va-logo"><b>{c.brand.name}</b><span>{c.brand.by}</span></span>
    <span class="va-links">{c.nav.map((n) => <a href={n.href}>{n.label}</a>)}</span>
    <a class="va-btn va-btn-pri va-btn-sm" href={c.cta.primaryHref}>{c.cta.primary}</a>
  </nav>

  <header class="va-sec">
    <h1>{c.hero.title}</h1>
    <p class="va-lead">{c.hero.lead}</p>
    <div class="va-ctas"><a class="va-btn va-btn-pri va-btn-lg" href={c.cta.primaryHref}>{c.cta.primary}</a></div>
    <div data-visual="chain"></div>
    <div class="va-logos"><span class="va-hint">{c.proof.label}</span>{c.proof.logos.map((l) => <span class="va-logo-ph">{l}</span>)}</div>
    <p class="va-fact">{c.proof.figures.map((f) => <span><b>{f.value}</b> {f.text}. </span>)}</p>
  </header>

  <section class="va-sec" id="trace">
    <h2>{c.dense.title}</h2>
    <p class="va-lead">{c.dense.lead}</p>
    <div data-visual="dense" data-jump="true"></div>
    <div class="va-shots">{c.dense.screenshots.map((s) => <div class="va-shot"><div class="va-shot-bar"><i></i><i></i><i></i></div><div class="va-shot-ph">Screenshot: {s}</div></div>)}</div>
  </section>

  <section class="va-sec">
    <h2>{c.map.title}</h2>
    <p class="va-lead">{c.map.lead}</p>
    <div data-visual="map"></div>
  </section>

  <section class="va-sec" id="features">
    <h2>{c.features.title}</h2>
    <p class="va-lead">{c.features.lead}</p>
    <div class="va-featured">
      <div class="va-stack">
        <h3>{c.features.bins.title}</h3>
        <p class="va-sub">{c.features.bins.text}</p>
        <p class="va-hint">{c.features.bins.hint}</p>
      </div>
      <div data-visual="bins"></div>
    </div>
    <div class="va-grid va-c3">{c.features.shipped.map(([g, d, t, x]) => <div class="va-feat"><Fragment set:html={featIcon(g, d)} /><h3>{t}</h3><p>{x}</p></div>)}</div>
    <div class="va-grid va-c5">{c.features.upcoming.map(([g, d, t, x]) => <div class="va-feat va-up"><div class="va-fh"><Fragment set:html={featIcon(g, d)} /><span class="va-chip">{c.features.upcomingLabel}</span></div><h3>{t}</h3><p>{x}</p></div>)}</div>
    <div class="va-stack va-compare">
      <h3>{c.compare.title}</h3>
      <div class="va-tbl"><table><thead><tr><th></th>{c.compare.columns.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{c.compare.rows.map(([a, b, d]) => <tr><td>{a}</td><td>{b}</td><td>{d}</td></tr>)}</tbody></table></div>
    </div>
  </section>

  <section class="va-sec" id="registry">
    <h2>{c.registry.title}</h2>
    <p class="va-lead">{c.registry.lead}</p>
    <div class="va-card"><div data-visual="morph"></div></div>
  </section>

  <section class="va-sec" id="open-source">
    <h2>{c.openSource.title}</h2>
    <div class="va-two">{c.openSource.cards.map((k) => <div class="va-card va-stack"><span class="va-chip">{k.chip}</span><h3>{k.title}</h3><p class="va-sub">{k.text}</p><div><a class="va-btn" href={k.href}>{k.action}</a></div></div>)}</div>
  </section>

  <section class="va-sec" id="walkthrough">
    <div class="va-featured">
      <div class="va-stack"><h2>{c.walkthrough.title}</h2><p class="va-lead">{c.walkthrough.lead}</p></div>
      <WalkthroughForm idPrefix="va" />
    </div>
  </section>

  <footer class="va-foot"><span>{c.footer.left}</span><span>{c.footer.right} <a href={c.cta.githubHref}>GitHub</a></span></footer>
</div>

</body>
</html>

<style>
  .va { max-width: 1240px; margin: 0 auto; padding-inline: 20px; }
  .va-nav { display: flex; align-items: center; gap: 22px; padding-block: 18px; border-bottom: 1px solid var(--hair); flex-wrap: wrap; }
  .va-logo { display: flex; align-items: baseline; gap: 7px; margin-right: auto; }
  .va-logo b { font-size: 24px; letter-spacing: -0.02em; }
  .va-logo span { font-size: 13px; color: var(--ink-3); }
  .va-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .va-links a { font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .va-sec { padding-block: 80px; display: grid; gap: 28px; border-bottom: 1px solid var(--hair); scroll-margin-top: 20px; }
  @media (max-width: 700px) { .va-sec { padding-block: 48px; } }
  .va h1 { font-size: clamp(40px, 6.6vw, 88px); letter-spacing: -0.04em; line-height: 1; max-width: 15ch; }
  .va h2 { font-size: clamp(30px, 4vw, 54px); letter-spacing: -0.03em; line-height: 1.04; max-width: 18ch; }
  .va h3 { font-size: 18px; }
  .va-lead { font-size: clamp(17px, 1.6vw, 21px); color: var(--ink-2); max-width: 58ch; }
  .va-sub { color: var(--ink-2); }
  .va-hint { font-size: 13px; color: var(--ink-3); }
  .va-stack { display: grid; gap: 12px; align-content: start; }
  .va-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .va-btn { display: inline-block; border: 1.5px solid var(--ink); border-radius: 8px; padding: 9px 16px; font-weight: 700; font-size: 15px; text-decoration: none; background: var(--paper); }
  .va-btn-pri { background: var(--ink); color: var(--paper); }
  .va-btn-lg { padding: 13px 22px; font-size: 17px; }
  .va-btn-sm { padding: 7px 12px; font-size: 13px; }
  .va-logos { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .va-logo-ph { border: 1.5px dashed var(--hair-2); border-radius: 6px; padding: 10px 16px; font-weight: 700; color: var(--ink-2); font-size: 14px; background: var(--paper); }
  .va-fact { font-size: 14px; color: var(--ink-2); }
  .va-fact b { color: var(--ink); }
  .va-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .va-shot { border: 1.5px solid var(--hair-2); border-radius: 8px; background: var(--paper); overflow: hidden; display: grid; grid-template-rows: auto 1fr; aspect-ratio: 16/10; }
  .va-shot-bar { display: flex; gap: 5px; padding: 8px 10px; border-bottom: 1px solid var(--hair); }
  .va-shot-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--hair-2); }
  .va-shot-ph { display: grid; place-items: center; color: var(--ink-3); font-size: 13px; padding: 16px; text-align: center; background: repeating-linear-gradient(135deg, var(--sea) 0 10px, transparent 10px 20px); }
  .va-featured { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 28px; align-items: start; background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 10px; padding: 26px; }
  @media (max-width: 900px) { .va-featured { grid-template-columns: 1fr; padding: 18px; } }
  .va-featured h3 { font-size: 26px; letter-spacing: -0.02em; }
  .va-grid { display: grid; gap: 1.5px; background: var(--hair-2); border: 1.5px solid var(--hair-2); border-radius: 10px; overflow: hidden; }
  .va-c3 { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .va-c5 { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .va-feat { background: var(--paper); padding: 22px; display: grid; gap: 9px; align-content: start; min-width: 0; }
  .va-feat p { font-size: 14px; color: var(--ink-2); }
  .va-up { background: var(--page); }
  .va-fh { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .va-chip { display: inline-flex; justify-self: start; font-size: 11.5px; font-weight: 700; border-radius: 999px; padding: 2px 9px; background: var(--infra-bg); color: var(--infra); }
  .va-compare { margin-top: 20px; }
  .va-compare h3 { font-size: clamp(22px, 2.6vw, 32px); letter-spacing: -0.02em; }
  .va-tbl { overflow-x: auto; border: 1.5px solid var(--hair-2); border-radius: 10px; background: var(--paper); }
  .va-tbl table { border-collapse: collapse; width: 100%; min-width: 620px; font-size: 15px; }
  .va-tbl th { text-align: left; font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); padding: 12px 16px; border-bottom: 1.5px solid var(--hair-strong); }
  .va-tbl td { padding: 13px 16px; border-bottom: 1px solid var(--hair); vertical-align: top; }
  .va-tbl td:first-child { font-weight: 700; width: 34%; }
  .va-tbl td:nth-child(2) { color: var(--ink-3); }
  .va-card { background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 10px; padding: 22px; }
  .va-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
  .va-two h3 { font-size: 22px; }
  .va-foot { padding-block: 28px 90px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; font-size: 13px; color: var(--ink-3); }
</style>

<script>
  import { mountVisuals } from "../visuals/index.js";
  mountVisuals();
</script>

---
// Product: Trace · Bins and stock · Evidence and reporting · What's next.
// Section ids come from PRODUCT_SECTIONS in src/config.js (Home links to them).
import SiteShell from "../components/site/SiteShell.astro";
import SectionIndex from "../components/site/SectionIndex.astro";
import GetStartedBand from "../components/site/GetStartedBand.astro";
import ProductIntro from "../components/site/product/ProductIntro.astro";
import TraceSection from "../components/site/product/TraceSection.astro";
import BinsSection from "../components/site/product/BinsSection.astro";
import EvidenceStage from "../components/site/product/EvidenceStage.astro";
import NextShowcase from "../components/site/product/NextShowcase.astro";
import { PRODUCT_SECTIONS } from "../config.js";
import "../components/site/product/product.css";
---
<SiteShell
  current="product"
  title="Product | noma"
  description="Follow biochar through the plant, keep the evidence with the work, and prepare reporting from the same records."
>
  <div class="pd">
    <ProductIntro />
    <SectionIndex items={PRODUCT_SECTIONS} />
    <TraceSection />
    <BinsSection />
    <EvidenceStage />
    <NextShowcase />
    <GetStartedBand />
  </div>
</SiteShell>

---
// Wraps one interactive visual: hairline frame, optional caption, optional `side` slot (text beside the visual).
// `attrs` become data-* attributes on the mount node (e.g. { "data-jump": "true" }).
interface Props { visual: string; caption?: string; attrs?: Record<string, string> }
const { visual, caption, attrs = {} } = Astro.props;
const hasSide = Astro.slots.has("side");
---
<figure class:list={["vf", { "has-side": hasSide }]}>
  {hasSide && <div class="side"><slot name="side" /></div>}
  <div class="stage">
    <div data-visual={visual} {...attrs}></div>
    {caption && <figcaption>{caption}</figcaption>}
  </div>
</figure>
<style>
  .vf { margin: 0; display: grid; gap: 32px var(--col-gap); }
  .vf.has-side { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr); align-items: start; }
  .stage { min-width: 0; border-top: var(--rule-strong); border-bottom: var(--rule); }
  figcaption { padding: 14px 0; font-size: var(--fs-small); color: var(--clr-dark-purple-70); border-top: var(--rule); }
  .side { display: grid; gap: 16px; align-content: start; }
  @media (max-width: 900px) { .vf.has-side { grid-template-columns: 1fr; } }
</style>

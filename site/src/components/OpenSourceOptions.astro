---
import TextLink from "./TextLink.astro";
interface Card { chip: string; title: string; text: string; action: string; href: string }
interface Props { cards: Card[] }
const { cards } = Astro.props;
---
<div class="options">
  {cards.map((k) => (
    <div class="option">
      <p class="tag label-micro">{k.chip}</p>
      <h3>{k.title}</h3>
      <p class="text">{k.text}</p>
      <TextLink href={k.href}>{k.action}</TextLink>
    </div>
  ))}
</div>
<style>
  .options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); }
  .option { background: var(--paper); border: var(--rule-strong); padding: clamp(24px, 3vw, 48px); display: grid; gap: 14px; align-content: start; justify-items: start; }
  .tag { color: var(--ink-2); }
  h3 { font-size: var(--fs-heading); letter-spacing: var(--track-heading); line-height: 1.02; }
  .text { font-size: var(--fs-lead); max-width: 40ch; }
  @media (max-width: 700px) { .options { grid-template-columns: 1fr; } }
</style>

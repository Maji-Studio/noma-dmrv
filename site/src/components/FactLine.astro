---
// The figures. A figure with `pending: true` (copy.js) is unconfirmed and gets the placeholder treatment.
import { copy } from "../content/copy.js";
interface Fig { value: string; text: string; pending?: boolean }
interface Props { figures: Fig[] }
const { figures } = Astro.props;
---
<dl class="facts">
  {figures.map((f) => (
    <div class="fact">
      <dt>{f.pending ? <mark data-placeholder title={copy.chrome.figurePlaceholder}>{f.value}</mark> : <strong>{f.value}</strong>}</dt>
      <dd>{f.text}</dd>
    </div>
  ))}
</dl>
<style>
  .facts { margin: 0; display: grid; gap: 0; }
  .fact { border-top: var(--rule); padding-block: 20px 24px; display: grid; gap: 6px; }
  dt { font-size: clamp(40px, 4.4vw, 64px); line-height: 1; letter-spacing: var(--track-heading); font-variant-numeric: tabular-nums lining-nums; }
  dd { margin: 0; font-size: var(--fs-small); color: var(--clr-dark-purple-70); max-width: 32ch; }
  strong { font-weight: 300; color: var(--clr-purple); }
  mark { display: inline-block; line-height: 1.08; padding-bottom: 2px; background: var(--clr-purple-10); color: var(--clr-purple); border-bottom: 2px dashed var(--clr-purple-40); padding: 0 6px; margin-left: -6px; }
</style>

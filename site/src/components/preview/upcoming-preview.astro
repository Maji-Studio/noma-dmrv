---
const { kind } = Astro.props;
---
<div class={`pv-future-demo pv-demo-${kind}`} aria-label="Upcoming feature concept, illustrative data">
  {kind === 'documents' && <>
    <div class="pv-document"><span>Weighbridge ticket</span><strong>FD-2026-014</strong><hr/><p>Wood residues</p><div><span>Net weight</span><b>2,400 kg</b></div><div><span>Moisture</span><b>20%</b></div><div class="pv-doc-lines"></div></div>
    <div class="pv-extracted"><span class="pv-muted">Ready for your review</span><strong>Feedstock delivery</strong><label>Wet mass <b>2,400 kg</b></label><label>Moisture <b>20%</b></label><span class="pv-check">✓ Values extracted</span></div>
  </>}
  {kind === 'reactor' && <div class="pv-reading"><div><span>Reactor temperature</span><span class="pv-muted">Example reading</span></div><strong>612 <small>°C</small></strong><svg viewBox="0 0 480 100" role="img" aria-label="Illustrative reactor temperature over time"><path d="M0 78H480M0 40H480" class="pv-chart-grid"/><path d="M0 86L28 83L56 65L85 69L115 44L144 50L175 29L206 35L238 17L268 23L298 20L328 15L358 22L389 13L420 18L450 14L480 18" class="pv-chart-line"/></svg><div class="pv-muted"><span>09:00</span><span>Production run PR-043</span><span>11:00</span></div></div>}
  {kind === 'telegram' && <div class="pv-chat"><span class="pv-muted">noma in Telegram</span><div class="pv-message pv-outgoing">Delivery received. 2,400 kg of wood residues from Sawmill A.</div><div class="pv-message">Draft feedstock delivery<br/><strong>2,400 kg · Sawmill A</strong><br/>Add the moisture reading and weighbridge ticket to complete the record.</div><span class="pv-chat-note">A conversation becomes a record.</span></div>}
  {kind === 'connections' && <div class="pv-connections"><div class="pv-connect-tools"><span>Reactor data</span><span>Your software</span><span>AI tools</span></div><div class="pv-connection-lines" aria-hidden="true"></div><div class="pv-connect-noma">noma<small>One connected record</small></div><p>Open API + MCP</p></div>}
  {kind === 'checks' && <div class="pv-check-demo"><span class="pv-muted">Production run PR-043</span><strong>A reading worth checking.</strong><div class="pv-warning"><span>!</span><p>Biochar output is higher than the feedstock input.</p></div><div class="pv-check-values"><p>Feedstock input<b>1,000 kg</b></p><p>Biochar output<b>1,200 kg</b></p></div><p class="pv-muted">Review the source record before reporting.</p></div>}
</div>

---
// Shipped features (three columns) and upcoming features (one row), separated by hairlines. Every upcoming item carries the chip.
import { featIcon } from "../visuals/core.js";
// [glyph, domain, title, text]
type Item = string[];
interface Props { shipped: Item[]; upcoming: Item[]; upcomingLabel: string; shippedHeading: string; upcomingHeading: string }
const { shipped, upcoming, upcomingLabel, shippedHeading, upcomingHeading } = Astro.props;
---
<div class="features">
  <h3 class="group-title">{shippedHeading}</h3>
  <ul class="grid shipped">
    {shipped.map(([g, d, t, x]) => (
      <li><Fragment set:html={featIcon(g, d)} /><h4>{t}</h4><p>{x}</p></li>
    ))}
  </ul>
  <h3 class="group-title">{upcomingHeading}</h3>
  <ul class="grid upcoming">
    {upcoming.map(([g, d, t, x]) => (
      <li>
        <div class="row"><Fragment set:html={featIcon(g, d)} /><span class="chip">{upcomingLabel}</span></div>
        <h4>{t}</h4><p>{x}</p>
      </li>
    ))}
  </ul>
</div>
<style>
  /* Cells fill the grid width; 1px gaps over a hairline ground draw the dividers at any column count. */
  .features { display: grid; gap: 24px; }
  .group-title { font-size: var(--fs-subheading); letter-spacing: -0.035em; margin-top: 24px; }
  .group-title:first-child { margin-top: 0; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--clr-purple-20); border: var(--rule-strong); }
  .shipped { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .upcoming { grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }
  li { background: var(--paper); padding: 28px var(--cell-pad) 40px; display: grid; gap: 10px; align-content: start; min-width: 0; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  h4 { font-size: 24px; letter-spacing: -0.03em; line-height: 1.2; font-weight: 300; }
  p { font-size: var(--fs-desc); line-height: 1.55; color: var(--clr-dark-purple-70); max-width: 42ch; }
  .chip { display: inline-block; padding: 2px 10px; font-size: var(--fs-fine); background: var(--st-wait-bg); color: var(--st-wait); border: 1px solid var(--st-wait-border); }
  @media (max-width: 900px) { .shipped { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .shipped { grid-template-columns: 1fr; } }
</style>

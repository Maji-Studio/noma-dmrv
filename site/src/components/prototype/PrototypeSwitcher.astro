---
// PROTOTYPE ONLY. Floating bar that cycles between the layout variants (full page loads; each variant is its own route).
// Arrow buttons, a select for jumping, and ← / → keys. Shown in dev, or with PUBLIC_SHOW_VARIANTS=true for a shared preview.
import { VARIANTS } from "../../variants/list.js";
interface Props { current: string }
const { current } = Astro.props;
const show = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_VARIANTS === "true";
const i = Math.max(0, VARIANTS.findIndex((v) => v.key === current));
const prev = VARIANTS[(i - 1 + VARIANTS.length) % VARIANTS.length];
const next = VARIANTS[(i + 1) % VARIANTS.length];
---
{show && (
  <div class="proto-bar" role="navigation" aria-label="Prototype layout variants" data-proto-bar data-prev={prev.href} data-next={next.href}>
    <a href={prev.href} aria-label={`Previous variant: ${prev.name}`}>←</a>
    <label>
      <span class="proto-sr">Layout variant</span>
      <select data-proto-select>
        {VARIANTS.map((v) => <option value={v.href} selected={v.key === current}>{v.key}. {v.name}</option>)}
      </select>
    </label>
    <a href={next.href} aria-label={`Next variant: ${next.name}`}>→</a>
  </div>
)}
<script>
  const bar = document.querySelector<HTMLElement>("[data-proto-bar]");
  if (bar) {
    const go = (href: string | undefined) => { if (href) location.href = href + location.hash; };
    bar.querySelector<HTMLSelectElement>("[data-proto-select]")?.addEventListener("change", (e) => go((e.currentTarget as HTMLSelectElement).value));
    document.addEventListener("keydown", (e) => {
      const t = e.target instanceof Element ? e.target : null;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (t?.closest("input, textarea, select, [contenteditable], svg, [data-visual], [role='slider']")) return;
      if (e.key === "ArrowLeft") go(bar.dataset.prev);
      if (e.key === "ArrowRight") go(bar.dataset.next);
    });
  }
</script>
<style>
  /* Deliberately off-system (black pill, system font) so it never reads as part of the design being judged. */
  .proto-bar { position: fixed; left: 50%; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 1000; display: flex; align-items: center; gap: 4px; background: #111; color: #fff; border-radius: 999px; padding: 6px; box-shadow: 0 8px 30px rgba(0,0,0,.35); font: 600 13px/1 ui-sans-serif, system-ui, sans-serif; max-width: calc(100vw - 24px); }
  .proto-bar a { display: grid; place-items: center; background: #333; color: #fff; text-decoration: none; border-radius: 999px; width: 32px; height: 32px; font-size: 15px; flex: none; }
  .proto-bar a:hover { background: #555; }
  .proto-bar select { background: #111; color: #fff; border: 0; font: inherit; padding: 0 8px; height: 32px; max-width: 60vw; }
  .proto-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .proto-bar :focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
</style>

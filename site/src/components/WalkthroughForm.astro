---
// Shared walkthrough request form. PROTOTYPE: submit is stubbed; the real endpoint is plan slice 4
// (site/src/pages/api/walkthrough.ts, Zod + honeypot + Resend). Style it from the page via the class hooks.
import { copy } from "../content/copy.js";
const { idPrefix } = Astro.props;
const w = copy.walkthrough;
---
<form class="wt-form" data-walkthrough novalidate>
  <div class="wt-row">
    <label for={`${idPrefix}-name`}>{w.fields.name}<input id={`${idPrefix}-name`} name="name" autocomplete="name" required /></label>
    <label for={`${idPrefix}-email`}>{w.fields.email}<input id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required /></label>
  </div>
  <div class="wt-row">
    <label for={`${idPrefix}-company`}>{w.fields.company}<input id={`${idPrefix}-company`} name="company" autocomplete="organization" required /></label>
    <label for={`${idPrefix}-size`}>{w.fields.size}<select id={`${idPrefix}-size`} name="size">{w.sizes.map((s) => <option>{s}</option>)}</select></label>
  </div>
  <label for={`${idPrefix}-msg`}>{w.fields.message}<textarea id={`${idPrefix}-msg`} name="message" rows="3"></textarea></label>
  <input class="wt-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="wt-actions"><button type="submit" class="wt-submit">{w.submit}</button></div>
  <p class="wt-sent" hidden>{w.sent} <span class="wt-proto">(Prototype: nothing was sent.)</span></p>
</form>
<style>
  .wt-form { display: grid; gap: 12px; min-width: 0; }
  .wt-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .wt-form label { display: grid; gap: 4px; font-size: 13px; color: var(--ink-2); }
  .wt-form input, .wt-form select, .wt-form textarea { border: 1.5px solid var(--hair-2); border-radius: 6px; padding: 10px 12px; background: var(--paper); font-size: 15px; width: 100%; }
  .wt-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .wt-submit { border: 1.5px solid var(--ink); background: var(--ink); color: var(--paper); border-radius: 8px; padding: 12px 20px; font-size: 16px; font-weight: 700; cursor: pointer; }
  .wt-sent { font-size: 14px; color: var(--ok); }
  .wt-proto { color: var(--ink-3); }
</style>
<script>
  document.querySelectorAll("form[data-walkthrough]").forEach((f) => {
    f.addEventListener("submit", (e) => { e.preventDefault(); (f.querySelector(".wt-sent") as HTMLElement).hidden = false; });
  });
</script>

---
// Product screenshot slot. Pass `src` with the image's pixel `width` and `height` (2x captures) to show it; the frame
// takes the image's aspect ratio. Without `src` a marked placeholder holds a 16:10 box. `lead` is the large first screenshot.
import { copy } from "../content/copy.js";
interface Props { caption: string; alt?: string; src?: string | null; width?: number; height?: number; lead?: boolean }
const { caption, alt = caption, src, width = 1440, height = 900, lead = false } = Astro.props;
---
<figure class:list={["shot", { lead }]}>
  <div class="frame" data-placeholder={src ? undefined : ""} style={src ? `aspect-ratio: ${width} / ${height}` : undefined}>
    {src ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /> : <span>{copy.chrome.screenshotPlaceholder}</span>}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .shot { margin: 0; display: grid; gap: 14px; align-content: start; min-width: 0; }
  .frame { aspect-ratio: 16 / 10; border: var(--panel-border); background: var(--paper); display: grid; place-items: center; text-align: center; font-size: var(--fs-small); color: var(--clr-dark-purple-70); overflow: hidden; }
  .frame[data-placeholder] { background: repeating-linear-gradient(135deg, var(--clr-purple-5) 0 1px, transparent 1px 14px); }
  .frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .frame span { padding: 16px; }
  figcaption { font-size: var(--fs-small); color: var(--clr-dark-purple-70); }
  .lead figcaption { font-size: var(--fs-body); color: var(--ink); }
</style>

---
// Product screenshot slot. PLACEHOLDER: renders a marked empty frame. Pass `src` to show the real image.
import { copy } from "../content/copy.js";
const { caption, src } = Astro.props;
---
<figure class="shot">
  <div class="frame" data-placeholder={src ? undefined : ""}>
    {src ? <img src={src} alt={caption} /> : <span>{copy.chrome.screenshotPlaceholder}</span>}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .shot { margin: 0; display: grid; gap: 12px; }
  .frame { aspect-ratio: 16 / 10; border: var(--rule); display: grid; place-items: center; text-align: center; padding: 16px; font-size: var(--fs-small); color: var(--clr-dark-purple-70); background: repeating-linear-gradient(135deg, var(--clr-purple-5) 0 1px, transparent 1px 14px); }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: var(--fs-small); color: var(--clr-dark-purple-70); }
</style>

---
/** ProofBlock: built with Dark Earth Carbon in Mafinga. Photo cell and copy cell. No props. */
import GridFrame from "../GridFrame.astro";
import TextLink from "../TextLink.astro";
---
<GridFrame class="proof" pad="none" flush aria-labelledby="proof-title">
  <div class="gf-cells proof-cells" style="--cols:2">
    <figure class="proof-figure">
      <img src="/preview/mafinga-field-trial.jpg" alt="Field trial plots in Mafinga, Tanzania" width="1400" height="933" loading="lazy" decoding="async" />
      <figcaption class="t-caption">Field trial plots, Mafinga, Tanzania</figcaption>
    </figure>
    <div class="proof-copy stack">
      <h2 id="proof-title" class="t-h2">Built with biochar producers.</h2>
      <p class="t-lead">We’re developing noma with Dark Earth Carbon in Mafinga, Tanzania, around the work of recording production and tracing biochar to its application.</p>
      <p class="t-body t-muted">The starting point is the work on the ground.</p>
      <TextLink href="/why#mafinga">Read about the work in Mafinga</TextLink>
    </div>
  </div>
</GridFrame>

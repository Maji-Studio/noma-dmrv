---
/**
 * ScaleRow: Home's short scale block. One line and four facts, linking to the full picture on
 * /product#scale (ScaleSection). No visual here on purpose: the drawing lives on Product. No props.
 */
import GridFrame from "../GridFrame.astro";
import TextLink from "../TextLink.astro";
import "./ask-section.css";

const FACTS = [
  { k: "Sites", v: "Several sites and reactors in one account" },
  { k: "Team", v: "Admins and members, each with their own access" },
  { k: "Entry", v: "Forms that work on a phone at the reactor" },
  { k: "Connect", v: "An open API and MCP for your other tools" },
];
---
<GridFrame class="sr" pad="none" flush aria-labelledby="sr-title">
  <div class="ask-head sr-head">
    <h2 id="sr-title" class="t-h2">From one reactor to many sites.</h2>
    <div class="stack-tight">
      <p class="t-lead">Add reactors and sites without starting a new spreadsheet.</p>
      <TextLink href="/product#scale">See how it scales</TextLink>
    </div>
  </div>
  <dl class="gf-cells sr-cells" style="--cols:4">
    {FACTS.map((f) => <div><dt class="t-category">{f.k}</dt><dd class="sr-v">{f.v}</dd></div>)}
  </dl>
</GridFrame>
<style>
  .sr-cells { margin: 0; border-top: var(--hairline) solid var(--rule); }
  .sr-cells > div { display: grid; gap: var(--space-3); align-content: start; padding-block: var(--space-7); }
  .sr-cells dt { margin: 0; }
  .sr-v { margin: 0; font-size: var(--fs-h4); letter-spacing: var(--track-h3); line-height: 1.25; }
  @media (max-width: 1100px) { .gf-cells.sr-cells { --cols: 2 !important; } }
  @media (max-width: 560px) { .gf-cells.sr-cells { --cols: 1 !important; } }
</style>

---
/**
 * TourStill: a square, static crop of one of the Product visuals, drawn in the site's tokens. Light and
 * decorative (aria-hidden): the cell's heading and text carry the meaning.
 * Props: kind: "bins" | "evidence" | "map"
 *   bins      the bins visual: sub-bins with dated layers, the truck cut off at the edge
 *   evidence  a record's check rows: three documents in place, the lab result still open
 *   map       the map: the plant, sawmills, fields and one lit route
 */
const { kind } = Astro.props;

const PQ = 16, SQ = 13, BED = 196; // square pitch and size, bin floor (same grammar as the bins visual)
// [bin left edge, rows, layer class]; the first bin is cut off at the frame edge.
const BINS = [[-28, 3, "l1"], [40, 7, "l2"], [108, 10, "l3"]];
const binSquares = BINS.flatMap(([x, rows, layer]) =>
  Array.from({ length: rows * 3 }, (_, k) => ({ x: x + 2 + (k % 3) * PQ, y: BED - (Math.floor(k / 3) + 1) * PQ + 1.5, layer })));
const truckSquares = Array.from({ length: 10 }, (_, k) => ({ x: 186 + (k % 5) * PQ, y: BED - (Math.floor(k / 5) + 1) * PQ + 1.5, layer: k < 5 ? "l1" : "l2" }));

const CHECKS = [
  { label: "Weighbridge ticket", ok: true },
  { label: "Moisture reading", ok: true },
  { label: "Transport document", ok: true },
  { label: "Lab result", ok: false },
];

const PLANT = [148, 104];
const SAWMILLS = [[118, 70], [176, 64], [196, 126]];
const FIELDS = [[34, 176], [58, 198], [24, 142], [92, 214], [206, 204], [226, 176]];
const arc = ([ax, ay], [bx, by]) => `M${ax},${ay} Q${(ax + bx) / 2 - (by - ay) * 0.2},${(ay + by) / 2 + (bx - ax) * 0.2} ${bx},${by}`;
---
<svg class:list={["still", `still--${kind}`]} viewBox="0 0 240 240" aria-hidden="true" focusable="false">
  <rect class="still-bg" width="240" height="240" />
  {kind === "bins" && <>
    {BINS.map(([x]) => <path class="still-wall" d={`M${x},${BED - 170} V${BED} H${x + 52} V${BED - 170}`} />)}
    {[...binSquares, ...truckSquares].map((q) => <rect class:list={["still-sq", q.layer]} x={q.x} y={q.y} width={SQ} height={SQ} />)}
    <path class="still-wall" d={`M182,${BED - 24} V${BED + 2} H244`} />
    <circle class="still-wheel" cx="206" cy={BED + 10} r="7" />
    <text class="still-lab" x="66" y={BED + 22} text-anchor="middle">Sub-bin 2</text>
    <text class="still-lab" x="134" y={BED + 22} text-anchor="middle">Sub-bin 3</text>
    <text class="still-sub" x="186" y={BED + 34}>Truck</text>
  </>}
  {kind === "evidence" && <>
    <text class="still-sub" x="24" y="40">Production run</text>
    <text class="still-code" x="24" y="66">PR-001</text>
    {CHECKS.map((c, i) => {
      const y = 92 + i * 36;
      return <g class:list={["still-row", !c.ok && "still-row--open"]} transform={`translate(0 ${y})`}>
        <path class="still-rule" d="M24,0 H240" />
        <rect class="still-cell" x="24" y="8" width="20" height="20" />
        {c.ok ? <path class="still-tick" d="M29,18 l4,4 l7,-8" /> : <text class="still-q" x="34" y="23" text-anchor="middle">?</text>}
        <text class="still-row-lab" x="56" y="22">{c.label}</text>
      </g>;
    })}
    <path class="still-rule" d="M24,236 H240" />
  </>}
  {kind === "map" && <>
    <g class="still-contours">
      <path d="M40,120 C40,70 110,40 160,54 C214,68 236,110 220,150 C204,190 130,206 84,190 C50,178 40,150 40,120 Z" />
      <path d="M74,122 C74,92 116,76 150,84 C186,92 200,116 190,140 C180,162 136,170 108,162 C86,156 74,142 74,122 Z" />
      <path d="M112,122 C112,108 130,100 146,104 C162,108 168,118 164,130 C160,142 140,146 128,142 C118,138 112,132 112,122 Z" />
    </g>
    <path class="still-road" d="M-4,232 L60,176 L148,104 L244,20" />
    {SAWMILLS.map((s) => <path class="still-arc still-arc--in" d={arc(s, PLANT)} />)}
    {FIELDS.map((f, i) => <path class:list={["still-arc", i === 0 && "still-arc--lit"]} d={arc(PLANT, f)} />)}
    {SAWMILLS.map(([x, y]) => <rect class="still-mark still-mark--sup" x={x - 6} y={y - 6} width="12" height="12" />)}
    {FIELDS.map(([x, y], i) => <rect class:list={["still-mark", "still-mark--app", i === 0 && "still-mark--lit"]} x={x - 5} y={y - 5} width="10" height="10" />)}
    <rect class="still-mark still-mark--plant" x={PLANT[0] - 10} y={PLANT[1] - 10} width="20" height="20" />
    <text class="still-town" x={PLANT[0] + 16} y={PLANT[1] - 12}>Mafinga</text>
    <text class="still-lab" x={PLANT[0] + 16} y={PLANT[1] + 5}>Plant</text>
  </>}
</svg>

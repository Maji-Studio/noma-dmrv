---
/**
 * PROTOTYPE ONLY: a small fixed switcher for the Home hero headline candidates (hero-variants.js).
 * Reads ?hero=n on load and swaps the hero's h1 and lead; the buttons update the URL so a link can be shared.
 * Remove with hero-variants.js once a headline is picked.
 */
import { HEROES } from "./hero-variants.js";
---
<div class="hs" data-hero-switch>
  <span class="hs-k">Headline</span>
  {HEROES.map((_, i) => <button type="button" data-n={i + 1} aria-pressed={i === 0 ? "true" : "false"}>{i + 1}</button>)}
</div>
<script>
  import { HEROES } from "./hero-variants.js";
  const box = document.querySelector("[data-hero-switch]");
  const h = document.querySelector("[data-hero-h]");
  const l = document.querySelector("[data-hero-l]");
  const show = (n: number) => {
    const v = HEROES[n - 1];
    if (!v || !h || !l) return;
    h.textContent = v.h;
    l.textContent = v.l;
    box?.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.n) === n)));
  };
  const start = Number(new URLSearchParams(location.search).get("hero")) || 1;
  show(start);
  box?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (!b) return;
    const n = Number(b.dataset.n);
    show(n);
    const u = new URL(location.href);
    u.searchParams.set("hero", String(n));
    history.replaceState(null, "", u);
  });
</script>
<style>
  .hs { position: fixed; z-index: 50; left: 50%; bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-2); background: var(--stage); color: var(--stage-ink); font-size: var(--fs-small); }
  .hs-k { padding-inline: var(--space-2); color: var(--stage-ink-2); }
  .hs button { min-width: 40px; min-height: var(--tap); font: inherit; color: inherit; background: transparent; border: 0; cursor: pointer; }
  .hs button[aria-pressed="true"] { background: var(--stage-lit); color: var(--stage); }
  .hs button:focus-visible { outline: 2px solid var(--stage-lit); outline-offset: -2px; }
</style>

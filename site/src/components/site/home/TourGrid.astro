---
/**
 * TourGrid: the short tour. Three cells, each a still of a Product visual linking to its section. The trace
 * is not repeated here: the hero and the stage above already show it. No props.
 */
import GridFrame from "../GridFrame.astro";
import TextLink from "../TextLink.astro";
import TourStill from "./TourStill.astro";
const BLOCKS = [
  { kind: "bins", title: "Know what’s in the bin.", text: "Keep track of material as it is stored, mixed and drawn, with wet and dry quantities at every step.", link: "See bins and stock", href: "/product#bins" },
  { kind: "evidence", title: "Keep the evidence with the record.", text: "Attach weighbridge tickets, transport documents, photos and lab results where they belong. See what is missing as you prepare a submission.", note: "The registry workflow is being developed against Isometric’s data model. Production submission is not available yet.", link: "See evidence and reporting", href: "/product#evidence" },
  { kind: "map", title: "See where it went.", text: "Connect suppliers, production and application sites. Select a field to trace its sources, or a supplier to see the destinations.", link: "Open the map", href: "/product#map" },
];
---
<GridFrame class="tour" pad="none" flush aria-labelledby="tour-title">
  <div class="tour-head">
    <h2 id="tour-title" class="t-h2">What else the records show.</h2>
    <div class="stack-tight">
      <p class="t-lead">The trace is one view of your records. The same records also tell you what is in each bin, which evidence backs each step, and where each load went.</p>
      <TextLink href="/why#spreadsheets">Compare it with a spreadsheet</TextLink>
    </div>
  </div>
  <div class="gf-cells tour-cells" style="--cols:3">
    {BLOCKS.map((b) => (
      <article class="tour-cell" aria-labelledby={`tour-${b.kind}`}>
        <TourStill kind={b.kind} />
        <h3 id={`tour-${b.kind}`} class="t-h3">{b.title}</h3>
        <p class="t-body t-muted">{b.text}</p>
        {b.note && <p class="t-caption">{b.note}</p>}
        <TextLink href={b.href}>{b.link}</TextLink>
      </article>
    ))}
  </div>
</GridFrame>

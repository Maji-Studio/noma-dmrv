---
/**
 * StageMark: the round status icon used in check rows and verdict pairs.
 * Props:
 *   kind?: "check" | "unknown" | "cross"   default "check" (filled); unknown (?) and cross (⊗) are outlined
 *   class?: string
 * Colour follows currentColor, so dim/lit come from the parent.
 */
const { kind = "check", class: className } = Astro.props;
---
<svg class:list={["stg-mark", `stg-mark--${kind}`, className]} viewBox="0 0 20 20" aria-hidden="true" focusable="false">
  {kind === "check" && <><circle cx="10" cy="10" r="9" fill="currentColor" /><path d="M6 10.4l2.6 2.5L14 7.6" fill="none" class="stg-mark-cut" /></>}
  {kind === "unknown" && <><circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" /><path d="M7.9 7.8a2.2 2.2 0 1 1 3.1 2c-.7.3-1 .8-1 1.5v.4" fill="none" stroke="currentColor" /><circle cx="10" cy="14.2" r=".9" fill="currentColor" /></>}
  {kind === "cross" && <><circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" /><path d="M7.2 7.2l5.6 5.6M12.8 7.2l-5.6 5.6" fill="none" stroke="currentColor" /></>}
</svg>

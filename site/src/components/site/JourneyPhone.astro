---
/**
 * JourneyPhone: what a buyer sees on the /journey page, simplified: one dark phone, the field at the top and
 * a rail back through the records to the sawmill, each step with its TraceStage icon and the record code.
 * The field is the one lit step. Same illustrative chain as TraceStage and the hero tour (coffee field,
 * DL-001, BP-001, mix bin, PR-001, FD-001, Sawmill A). Readable text; the caller decides the heading.
 * Props: class?: string
 */
import Phone from "./Phone.astro";
import { TRACE_ICONS, ICON_VIEWBOX } from "./home/trace-icons.js";

const STEPS: { icon: keyof typeof TRACE_ICONS; name: string; where: string; v: string; lit?: boolean }[] = [
  { icon: "application", name: "Applied", where: "Coffee field", v: "270 kg dry", lit: true },
  { icon: "delivery", name: "Delivered", where: "DL-001", v: "Bill of lading" },
  { icon: "biochar-product", name: "Bagged", where: "BP-001", v: "540 kg dry" },
  { icon: "mix-bin", name: "Stored", where: "Mix bin", v: "Two runs" },
  { icon: "production-run", name: "Made", where: "PR-001", v: "Reactor 1" },
  { icon: "feedstock-delivery", name: "Received", where: "FD-001", v: "Sawmill A" },
];
const { class: className } = Astro.props;
---
<Phone tone="dark" label="Follow this biochar" class={className}>
  <div class="jp-top">
    <span class="jp-k">Coffee field</span>
    <span class="jp-big">270 kg <span>dry biochar</span></span>
  </div>
  <ol class="jp-rail">
    {STEPS.map((s) => (
      <li class:list={[s.lit && "is-lit"]}>
        <svg class="jp-icon" viewBox={ICON_VIEWBOX} aria-hidden="true" set:html={TRACE_ICONS[s.icon]} />
        <span class="jp-name">{s.name}</span>
        <span class="jp-where">{s.where}</span>
        <span class="jp-v">{s.v}</span>
      </li>
    ))}
  </ol>
</Phone>
<style>
  .jp-top { display: grid; gap: var(--space-1); padding-bottom: var(--space-3); border-bottom: var(--hairline) solid var(--stage-line-dim); }
  .jp-k { font-size: var(--fs-caption); color: var(--stage-ink-2); }
  .jp-big { font-size: var(--fs-h4); letter-spacing: var(--track-h3); line-height: 1.1; }
  .jp-big span { font-size: var(--fs-caption); letter-spacing: 0; color: var(--stage-ink-2); }
  .jp-rail { display: grid; margin: 0; padding: 0; list-style: none; }
  .jp-rail li { position: relative; display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; grid-template-areas: "icon name v" "icon where v"; column-gap: var(--space-3); align-items: center; padding-block: var(--space-2); font-size: var(--fs-caption); color: var(--stage-ink-2); }
  .jp-rail li + li::before { content: ""; position: absolute; left: 1rem; top: calc(var(--space-2) * -0.5 - 4px); height: 8px; border-left: var(--hairline) dashed var(--stage-line); }
  .jp-icon { grid-area: icon; width: 2rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .jp-icon :global(.ts-icon-mask) { fill: var(--stage); }
  .jp-name { grid-area: name; color: var(--stage-ink); font-size: var(--fs-small); }
  .jp-where { grid-area: where; font-family: var(--f-mono); letter-spacing: var(--track-mono); }
  .jp-v { grid-area: v; text-align: right; }
  .jp-rail li.is-lit, .jp-rail li.is-lit .jp-name { color: var(--stage-lit); }
</style>

---
/**
 * TextLink: underlined editorial link, 44px tap height.
 * Props:
 *   href: string
 *   tone?: "page" | "stage"   default "page"; "stage" for dark bands
 *   external?: boolean        appends a small ↗ (for GitHub and other sites), outside the underline
 *   class?: string            merged, one class attribute
 *   ...rest                   passed to the <a>
 * Label: default slot. No trailing arrows on internal links.
 */
const { href, tone = "page", external = false, class: className, ...rest } = Astro.props;
---
<a href={href} class:list={["tl", tone === "stage" && "tl--stage", className]} {...rest}>{external
  ? <span class="tl-label"><slot /><span class="tl-ext" aria-hidden="true">↗</span></span>
  : <slot />}</a>

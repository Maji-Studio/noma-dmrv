---
/**
 * OpenSource: "Yours to inspect. Yours to run." The two ways to run noma, from /preview/open-source,
 * as two square cells with a short spec list each. Self-host links to GitHub, let us run it to
 * /get-started. No props.
 */
import { GITHUB_URL } from "../../../config.js";
import GridFrame from "../GridFrame.astro";
import Button from "../Button.astro";
const OPTIONS = [
  {
    id: "self-host",
    title: "Self-host noma.",
    text: "Run the MIT-licensed code on your own infrastructure. Inspect it, adapt it and contribute improvements.",
    spec: [["Licence", "MIT"], ["Built with", "Next.js and PostgreSQL"], ["Setup", "Instructions in the repository"]],
    action: { label: "View on GitHub", href: GITHUB_URL, external: true, variant: "secondary" },
  },
  {
    id: "run-it",
    title: "Let us run it.",
    text: "Talk to us about setup, hosting and ongoing updates for your operation.",
    spec: [["We handle", "Setup, hosting and updates"], ["Code", "The same open-source code"], ["Your data", "Stays yours"]],
    action: { label: "Book a walkthrough", href: "/get-started", variant: "primary" },
  },
];
---
<GridFrame id="open-source" class="os" pad="none" flush aria-labelledby="os-title">
  <div class="why-head">
    <h2 id="os-title" class="t-h2">Yours to inspect. Yours to run.</h2>
    <p class="t-lead">Transparency includes the software. Review how noma connects records and calculates quantities, and choose how you want to run it.</p>
  </div>
  <div class="gf-cells os-cells" style="--cols:2">
    {OPTIONS.map((o) => (
      <section class="os-cell" aria-labelledby={`os-${o.id}`}>
        <div class="stack-tight">
          <h3 id={`os-${o.id}`} class="t-h3">{o.title}</h3>
          <p class="t-body t-muted">{o.text}</p>
        </div>
        <dl class="os-spec">
          {o.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <Button href={o.action.href} variant={o.action.variant}>
          {o.action.label}{o.action.external && <span aria-hidden="true">↗</span>}
        </Button>
      </section>
    ))}
  </div>
</GridFrame>

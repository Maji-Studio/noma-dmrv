---
/**
 * Mafinga: built with Dark Earth Carbon in Mafinga, Tanzania. The field-trial photo runs the full width
 * of the frame under the copy, with the caption under it. No props.
 */
import GridFrame from "../GridFrame.astro";
---
<GridFrame id="mafinga" class="maf" pad="none" flush aria-labelledby="maf-title">
  <div class="why-head maf-copy">
    <h2 id="maf-title" class="t-h2">Built with Dark Earth Carbon in Mafinga, Tanzania.</h2>
    <div class="stack">
      <p class="t-lead">We’re developing noma with Dark Earth Carbon in Mafinga, Tanzania, around the work of recording production and tracing biochar to its application.</p>
      <p class="t-body t-muted">The starting point is the work on the ground: deliveries at the weighbridge, runs at the reactor, draws from each bin and the fields where the biochar goes into the soil.</p>
    </div>
  </div>
  <figure class="maf-figure">
    <img src="/preview/mafinga-field-trial.jpg" alt="Field trial plots in Mafinga, Tanzania" width="1400" height="933" loading="lazy" decoding="async" />
    <figcaption class="t-caption">Field trial plots, Mafinga, Tanzania</figcaption>
  </figure>
</GridFrame>

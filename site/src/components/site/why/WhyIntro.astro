---
/** WhyIntro: the page headline and lead for /why. No props. */
import GridFrame from "../GridFrame.astro";
import "./why.css";
---
<GridFrame class="why-intro" pad="none" flush aria-labelledby="page-title">
  <div class="why-intro-in">
    <p class="t-category">Why noma</p>
    <h1 id="page-title" class="t-display">One set of records, from the plant to the verifier.</h1>
    <div class="why-intro-lead">
      <p class="t-lead">Producers record the work. Carbon and MRV managers report on it. Verifiers check it. noma keeps all three working from the same connected records, with the evidence attached.</p>
      <p class="t-body t-muted">Open source, and developed with Dark Earth Carbon in Mafinga, Tanzania.</p>
    </div>
  </div>
</GridFrame>

---
/**
 * DrawMethods: under the bin stepper, the three ways a bin can give up stock, side by side on bin A's layers
 * (BIN_LAYERS) for the same 400 kg dry draw: oldest first (FIFO), newest first (LIFO) and mixed (pro rata,
 * mass weighted). Each layer is a row in the bin; the drawn share is the dashed part on the right. The app
 * sets this per bin (split bins: oldest or newest first; mix bins: pro rata). No props.
 */
import GridFrame from "../GridFrame.astro";
import { BIN_LAYERS } from "../../../data/data.js";

const DRAW = 400; // kg dry, as in BinsSection
const TOTAL = BIN_LAYERS.reduce((s, l) => s + l.dry, 0);
const kg = (n: number) => `${n} kg`;

// Kilograms taken from each layer (index 0 = oldest) under one method.
const ordered = (order: number[]) => {
  let owed = DRAW;
  const take = BIN_LAYERS.map(() => 0);
  for (const i of order) { take[i] = Math.min(owed, BIN_LAYERS[i].dry); owed -= take[i]; }
  return take;
};
const proRata = () => {
  const take = BIN_LAYERS.map((l) => Math.round((l.dry * DRAW) / TOTAL));
  take[take.length - 1] += DRAW - take.reduce((s, n) => s + n, 0); // rounding lands on the newest layer
  return take;
};
const METHODS = [
  { key: "fifo", name: "Oldest first", tag: "FIFO", take: ordered([0, 1, 2]), text: "Empties the oldest run before it touches the next." },
  { key: "lifo", name: "Newest first", tag: "LIFO", take: ordered([2, 1, 0]), text: "Takes the latest run first, for bins filled from the top." },
  { key: "mix", name: "Mixed", tag: "Mass weighted", take: proRata(), text: "Takes from every run in proportion to what it holds." },
];

// Bin drawing, user units: one row per layer, newest on top; a row's width is its dry mass.
const W = 200, ROW = 30, GAP = 6, PAD = 10;
const H = BIN_LAYERS.length * (ROW + GAP) - GAP;
const scale = W / Math.max(...BIN_LAYERS.map((l) => l.dry));
const rows = BIN_LAYERS.map((l, i) => ({ ...l, sw: `l${i + 1}`, y: PAD + (BIN_LAYERS.length - 1 - i) * (ROW + GAP) }));
---
<GridFrame class="dm" pad="none" flush aria-labelledby="dm-title">
  <div class="pd-head dm-head">
    <h3 id="dm-title" class="t-h3">Choose how each bin gives up stock.</h3>
    <p class="t-body t-muted">The same {kg(DRAW)} drawn from bin A, three ways. Each bin keeps its own method, and every kilogram drawn stays traced to the runs it came from.</p>
  </div>
  <div class="gf-cells dm-cells" style="--cols:3">
    {METHODS.map((m) => (
      <article aria-labelledby={`dm-${m.key}`}>
        <p class="dm-tag">{m.tag}</p>
        <h4 id={`dm-${m.key}`} class="dm-name">{m.name}</h4>
        <svg class="dm-bin" viewBox={`0 0 ${W + 2 * PAD} ${H + 2 * PAD}`} role="img" aria-label={`${m.name}: ${rows.map((r, i) => `${kg(m.take[i])} from the run placed ${r.date}`).join(", ")}.`}>
          {rows.map((r, i) => {
            const full = r.dry * scale, drawn = m.take[i] * scale;
            return <>
              <rect class={`dm-left dm-sw--${r.sw}`} x={PAD} y={r.y} width={Math.max(full - drawn, 0)} height={ROW} />
              {drawn > 0 && <rect class="dm-drawn" x={PAD + full - drawn + 0.75} y={r.y + 0.75} width={drawn - 1.5} height={ROW - 1.5} />}
            </>;
          })}
          <path class="dm-wall" d={`M${PAD / 2} ${PAD / 2}V${H + PAD * 1.5}H${W + PAD * 1.5}V${PAD / 2}`} />
        </svg>
        <ul class="dm-rows">
          {rows.map((r, i) => <li><i class={`dm-sw dm-sw--${r.sw}`}></i><span>Placed {r.date}</span><b>{m.take[i] ? kg(m.take[i]) : "none"}</b></li>).reverse()}
        </ul>
        <p class="t-body t-muted dm-text">{m.text}</p>
      </article>
    ))}
  </div>
</GridFrame>
<style>
  .dm-head { padding-top: var(--space-8); }
  .dm-head h3 { max-width: 18ch; margin: 0; }
  .dm-cells { border-top: var(--hairline) solid var(--rule); }
  .dm-cells > article { display: grid; align-content: start; gap: var(--space-3); }
  .dm-tag { margin: 0; font-family: var(--f-mono); font-size: var(--fs-mono); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent); }
  .dm-name { margin: 0; font-size: var(--fs-h4); font-weight: 300; letter-spacing: var(--track-h3); }
  .dm-bin { width: min(100%, 260px); margin-block: var(--space-4); overflow: visible; }
  .dm-left { stroke: none; }
  .dm-sw--l1 { fill: var(--l1); background: var(--l1); } .dm-sw--l2 { fill: var(--l2); background: var(--l2); } .dm-sw--l3 { fill: var(--l3); background: var(--l3); }
  .dm-drawn { fill: var(--paper); stroke: var(--accent); stroke-width: 1.25; stroke-dasharray: 3 3; vector-effect: non-scaling-stroke; }
  .dm-wall { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .dm-rows { display: grid; margin: 0; padding: 0; list-style: none; border-top: var(--hairline) solid var(--rule); font-size: var(--fs-small); }
  .dm-rows li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-3); padding-block: var(--space-2); border-bottom: var(--hairline) solid var(--rule); }
  .dm-rows b { font-weight: 400; font-variant-numeric: tabular-nums; }
  .dm-sw { width: 12px; height: 12px; }
  .dm-text { font-size: var(--fs-ui); }
  @media (max-width: 900px) { .gf-cells.dm-cells { --cols: 1 !important; } }
</style>

---
/**
 * TraceSection (#trace): following material both ways. A section head over TraceExplorer. No props.
 */
import GridFrame from "../GridFrame.astro";
import TraceExplorer from "../trace/TraceExplorer.astro";
---
<GridFrame id="trace" pad="none" flush aria-labelledby="trace-title">
  <div class="pd-head">
    <h2 id="trace-title" class="t-h2">Follow the material.</h2>
    <p class="t-lead">Trace an application back to its sources, or see where a production run’s biochar ended up. Follow the connections through storage, mixing and delivery.</p>
  </div>
  <TraceExplorer />
</GridFrame>

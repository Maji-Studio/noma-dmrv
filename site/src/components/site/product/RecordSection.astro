---
/**
 * RecordSection (#record): data entry at the reactor. The phone still from Mafinga (PHOTOS.phone), then two phones on the hatch, each a simplified app form
 * with one typo the app refuses: moisture typed as 180 on feedstock delivery FD-001, and a run's biochar
 * typed as 2,700 kg dry against 820 kg dry in. The refusal lines are the app's own messages
 * (src/schemas/feedstocks.ts, src/lib/production-runs/lifecycle.ts). Records match the site's example
 * chain (FD-001 1,000 kg wet, PR-001 270 kg dry). No props.
 */
import GridFrame from "../GridFrame.astro";
import Phone from "../Phone.astro";
import Photo from "../Photo.astro";

const MOISTURE_REFUSAL = "Moisture must be below 100";
const DRY_REFUSAL = "Dry output exceeds dry input. Reduce the biochar output or correct the moisture values.";
type Field = { k: string; v: string; error?: string; link?: boolean; calc?: boolean };
const FORMS: { label: string; alt: string; fields: Field[]; action: string }[] = [
  {
    label: "New feedstock delivery",
    alt: `Feedstock delivery FD-001 from Sawmill A into feedstock bin F1, 1,000 kg wet. Moisture was typed as 180, and the form says: ${MOISTURE_REFUSAL}.`,
    fields: [
      { k: "Supplier", v: "Sawmill A" },
      { k: "Feedstock bin", v: "Bin F1" },
      { k: "Wet mass", v: "1,000 kg" },
      { k: "Moisture", v: "180 %", error: MOISTURE_REFUSAL },
    ],
    action: "Save delivery",
  },
  {
    label: "Finish production run",
    alt: `Production run PR-001 drew FD-001 from bin F1, 820 kg dry in. Biochar out was typed as 2,700 kg dry, and the form says: ${DRY_REFUSAL}`,
    fields: [
      { k: "Drawn from", v: "Bin F1, holds FD-001", link: true },
      { k: "Dry input", v: "820 kg", calc: true },
      { k: "Biochar out", v: "2,700 kg dry", error: DRY_REFUSAL },
    ],
    action: "Finish run",
  },
];
---
<GridFrame id="record" pad="none" flush aria-labelledby="record-title">
  <div class="pd-head">
    <h2 id="record-title" class="t-h2">Record it once, at the reactor.</h2>
    <p class="t-lead">Your team logs deliveries, runs and draws on a phone where the work happens. Each entry links to the one before it, and noma refuses values that cannot be true before they reach a report.</p>
  </div>
  <figure class="rc-figure">
    <Photo photo="phone" />
    <figcaption class="t-caption">noma on a phone at the plant, Mafinga, Tanzania</figcaption>
  </figure>
  <div class="rc-sheet">
    {FORMS.map((f) => (
      <div role="img" aria-label={f.alt}>
        <Phone label={f.label}>
          {f.fields.map((x) => (
            <div class:list={["rc-field", x.error && "is-error"]}>
              <span class="rc-k">{x.k}</span>
              <span class:list={["rc-v", x.link && "is-link", x.calc && "is-calc"]}>{x.v}</span>
              {x.error && <span class="rc-err">{x.error}</span>}
            </div>
          ))}
          <span class="rc-btn">{f.action}</span>
        </Phone>
      </div>
    ))}
  </div>
</GridFrame>
<style>
  .rc-figure { position: relative; margin: 0; border-top: var(--hairline) solid var(--rule); }
  .rc-figure :global(.photo) { aspect-ratio: 21 / 8; min-height: var(--photo-min); object-position: center 40%; }
  .rc-figure figcaption { position: absolute; right: var(--frame-pad); bottom: var(--space-4); padding: var(--space-1) var(--space-2); background: var(--page); }
  @media (max-width: 760px) {
    .rc-figure :global(.photo) { aspect-ratio: 4 / 3; min-height: 0; }
    .rc-figure figcaption { position: static; padding: var(--space-3) var(--frame-pad); }
  }
  .rc-sheet { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-7); padding: var(--space-8) var(--frame-pad); background: var(--hatch); border-top: var(--hairline) solid var(--rule); }
  .rc-sheet > div { display: grid; justify-items: center; flex: 1 1 15rem; max-width: 18rem; }
  .rc-field { display: grid; gap: var(--space-1); }
  .rc-k { font-size: var(--fs-caption); color: var(--ink-2); }
  .rc-v { padding: var(--space-2) var(--space-3); background: var(--paper); border: var(--hairline) solid var(--rule-strong); font-size: var(--fs-small); font-variant-numeric: tabular-nums; }
  .rc-v.is-link { color: var(--accent); }
  .rc-v.is-calc { background: transparent; border-style: dashed; color: var(--ink-2); }
  .is-error .rc-v { border-color: var(--warn); box-shadow: inset 0 0 0 1px var(--warn); }
  .rc-err { font-size: var(--fs-caption); line-height: 1.4; color: var(--warn); }
  .rc-btn { justify-self: start; margin-top: var(--space-2); padding: var(--space-2) var(--space-4); background: var(--accent); color: var(--paper); font-size: var(--fs-small); opacity: 0.45; }
</style>

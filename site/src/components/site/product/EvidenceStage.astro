---
/**
 * EvidenceStage (#evidence): the Product page's one keynote stage. A feedstock delivery on the left (a truck
 * on the weighbridge) with its evidence as check rows; the certifier on the right (a review window with a
 * certification seal) with the fields that evidence fills. Each record row sits level with the certifier field
 * it maps to, through an adapter node: our names in, the certifier's names out (moisture reading to moisture
 * content, lab result to carbon content, weighbridge ticket to feedstock mass).
 * Choreography (one playhead): the weighbridge terminal settles and the record rows tick, with the lab result
 * missing. Moisture, then weighbridge, map across and fill their certifier fields. The lab result arrives and
 * maps last. Then the submission is approved: the seal closes and the certifier rows light (the one lit group).
 * At rest (no JS, reduced motion) the stage shows the approved end state.
 * Stacks vertically under 960px (record, a vertical wire with one adapter, then the certifier). No props.
 */
import Stage from "../stage/Stage.astro";
import StageCheckRow from "../stage/StageCheckRow.astro";
import StageConnector from "../stage/StageConnector.astro";
import StageMark from "../stage/StageMark.astro";
import TextLink from "../TextLink.astro";
import "./evidence-stage.css";

// Delays in ms from the moment the stage plays. Each link draws for T.wireDur, then its certifier field fills.
const T = { leds: [150, 300, 450], rows: [300, 450, 600], bridge: 700, wireDur: 500, arrive: 2600, ok: 4100, okStep: 120 };
// One entry per level: the record row, the certifier field it maps to, and when the link draws.
const PAIRS = [
  { record: { label: "Moisture reading", meta: "12%" }, registry: { label: "Moisture content", meta: "12%" }, draw: 1000 },
  { record: { label: "Lab result", meta: "Attached", from: "Missing" }, registry: { label: "Carbon content", meta: "48%" }, draw: 3000 },
  { record: { label: "Weighbridge ticket", meta: "2,400 kg" }, registry: { label: "Feedstock mass", meta: "2,400 kg" }, draw: 1600 },
];
const fill = (p) => p.draw + T.wireDur;
const FIELD_Y = [44, 76, 108];
const ms = (n) => `${n}ms`;
const ALT = "Animated diagram with illustrative records. On the left, feedstock delivery FD-2026-014, a truck on the weighbridge, and its evidence: a moisture reading of 12%, a lab result that starts out missing and then arrives, and a weighbridge ticket for 2,400 kg. On the right, the certifier's review window with a certification seal. Each record maps across to the certifier's own field: moisture reading to moisture content, 12%; lab result to carbon content, 48%; weighbridge ticket to feedstock mass, 2,400 kg. Once all three are filled, the seal closes and the submission is approved.";
---
<Stage
  id="evidence"
  kicker="Evidence and reporting"
  title="Keep the evidence with the record."
  lead="Attach weighbridge tickets, transport documents, photos and lab results where they belong. See what is missing as you prepare a submission."
  alt={ALT}
  revealMs={T.ok + 900}
>
  <TextLink slot="action" href="/get-started" tone="stage">Book a walkthrough</TextLink>
  <div class="ev" style={`--ev-ok:${ms(T.ok)};--ev-ok-step:${ms(T.okStep)}`}>
    <svg class="ev-art ev-art--record" viewBox="0 0 460 148" preserveAspectRatio="xMidYMid meet">
      <path class="ev-art-dim" d="M0 142H460" />
      <rect x="16" y="126" width="318" height="10" />
      <path class="ev-art-dim" d="M40 136V142M175 136V142M310 136V142" />
      <path class="ev-art-dim" d="M36 38C66 16 104 10 134 20S204 18 228 38" />
      <rect x="32" y="38" width="200" height="60" />
      <path d="M28 98H322" />
      <path d="M244 98V50H290L320 80V98" />
      <path class="ev-art-dim" d="M252 58H286L306 80H252Z" />
      {[70, 102, 272].map((cx) => <circle cx={cx} cy="112" r="14" />)}
      <path class="ev-art-dim ev-art-dot" d="M334 131H398" />
      <path d="M398 142V76" />
      <rect x="366" y="20" width="72" height="56" />
      <path class="ev-art-dim" d="M380 60H424" />
      {[384, 400, 416].map((cx, i) => <circle class="ev-led ev-led--on" style={`--ev-at:${ms(T.leds[i])}`} cx={cx} cy="40" r="4.5" />)}
    </svg>
    <div class="ev-bridge"><StageConnector variant="dotted" state="dim" length="100%" delay={ms(T.bridge)} class="ev-bridge-line" /></div>
    <svg class="ev-art ev-art--registry" viewBox="0 0 460 148" preserveAspectRatio="xMidYMid meet">
      <rect x="1" y="1" width="458" height="146" />
      <path d="M1 28H459" />
      {[22, 38, 54].map((x) => <circle class="ev-led" cx={x} cy="14.5" r="4.5" />)}
      <text class="ev-art-label" x="76" y="18.5">CERTIFIER REVIEW</text>
      {PAIRS.map((p, i) => (
        <g>
          <path class="ev-art-dim" d={`M24 ${FIELD_Y[i] + 11}H84`} />
          <rect class="ev-field ev-field--open" x="100" y={FIELD_Y[i]} width="224" height="22" />
          <g class="ev-fill" style={`--ev-at:${ms(fill(p))}`}>
            <rect class="ev-field" x="100" y={FIELD_Y[i]} width="224" height="22" />
            <path d={`M112 ${FIELD_Y[i] + 11}H${172 + i * 18}`} />
          </g>
        </g>
      ))}
      <g class="ev-seal">
        <path class="ev-seal-to" d="M374 104L366 138L376 132L383 141L388 108M410 104L418 138L408 132L401 141L396 108" />
        <g class="ev-seal-from">
          <circle class="ev-seal-dash" cx="392" cy="80" r="30" />
          <circle cx="392" cy="80" r="22" />
          <text class="ev-art-label ev-seal-q" x="392" y="84" text-anchor="middle">?</text>
        </g>
        <g class="ev-seal-to">
          <circle cx="392" cy="80" r="30" />
          <circle cx="392" cy="80" r="22" />
          <path d="M382 80L389 87L403 73" />
        </g>
      </g>
    </svg>

    <p class="ev-cap ev-cap--record"><span>Feedstock delivery</span><span>FD-2026-014</span></p>
    <p class="ev-cap ev-cap--map" aria-hidden="true">Maps to</p>
    <p class="ev-cap ev-cap--registry"><span>For the certifier</span><span>In development</span></p>

    <ul class="ev-rows ev-rows--record">
      {PAIRS.map(({ record: r }, i) => r.from
        ? (
          <li class="stg-row stg-row--default ev-arrive" style={`--i:0;--delay:${ms(T.arrive)}`}>
            <span class="stg-row-icon"><StageMark kind="unknown" class="ev-from" /><StageMark kind="check" /></span>
            <span class="stg-row-label">{r.label}</span>
            <span class="stg-row-meta"><span class="ev-from">{r.from}</span><span class="ev-to">{r.meta}</span></span>
          </li>
        )
        : <StageCheckRow as="li" label={r.label} meta={r.meta} delay={ms(T.rows[i])} />)}
    </ul>
    <div class="ev-links">
      {PAIRS.map((p) => (
        <div class="ev-link">
          <StageConnector variant="dotted" cap="ring" length="100%" delay={ms(p.draw)} duration={ms(T.wireDur)} />
          <span class="ev-adapter stg-fade" style={`--i:0;--delay:${ms(p.draw + T.wireDur / 2)}`}></span>
        </div>
      ))}
    </div>
    <div class="ev-link-v">
      <StageConnector variant="dotted" direction="v" cap="ring" length="100%" delay={ms(PAIRS[0].draw)} duration={ms(T.wireDur)} />
      <span class="ev-adapter stg-fade" style={`--i:0;--delay:${ms(PAIRS[0].draw + T.wireDur / 2)}`}></span>
    </div>
    <ul class="ev-rows ev-rows--registry">
      {PAIRS.map((p) => <StageCheckRow as="li" label={p.registry.label} meta={p.registry.meta} dashed state="lit" delay={ms(fill(p))} />)}
    </ul>
    <p class="ev-note ev-note--record">Illustrative records</p>
    <p class="ev-note ev-note--registry">The registry workflow is being developed against Isometric’s data model. Production submission is not available yet.</p>
  </div>
</Stage>

---
/**
 * BinsSection (#bins): one bin, told in four steps the visitor clicks through (step tabs, Back, Next) on a
 * dark stage: one big figure per step beside one picture made of 10 kg squares. The same squares carry the
 * story: biochar with its water mixed in (dashed) drops into bin A in layers, the oldest draw slides onto
 * the truck with its water while the rest settle, the weighbridge weighs both and the water lights up, then
 * a tractor drives across the field and sows the load into the topsoil column by column, the crop sprouts
 * behind it, and the water dims, since only the dry biochar counts.
 * The markup is the last step with every step's text listed, so without JS everything is readable;
 * bins-steps.js arms the stepper. No props.
 *
 * Illustrative numbers: every layer at one moisture (M), so the water in the bin and on the truck add up.
 * SVG geometry: user units. A square is 16 with a 20 pitch. Bin A is 10 squares wide, the truck bed 8, the
 * field 24. BY is the floor shared by bin and truck bed, and the bottom of the field's topsoil; GY is the
 * field's ground. The tractor drives at SPEED, so each square's sowing and each plant's growth are timed
 * to the moment the hopper passes over it.
 */
import GridFrame from "../GridFrame.astro";
import { BIN_LAYERS } from "../../../visuals/data.js";
import "./bins-steps.css";

const [l1, l2, l3] = BIN_LAYERS;
const KG_PER_SQ = 10;
const M = 15; // % moisture, the same in every layer and at departure
const DRAW = 400; // kg dry biochar drawn
const waterOf = (dry) => (dry * M) / (100 - M);
const TOTAL = l1.dry + l2.dry + l3.dry; // 810
const WATER_IN = Math.round(waterOf(TOTAL)); // 143
const FROM_L1 = Math.min(DRAW, l1.dry); // 270
const FROM_L2 = DRAW - FROM_L1; // 130
const WATER = Math.round(waterOf(DRAW)); // 71
const WET = DRAW + WATER; // 471
const FIELD_HA = 0.2; // illustrative field size
const RATE = DRAW / (FIELD_HA * 1000); // t dry biochar per hectare: 2
const kg = (n) => `${n}\u00a0kg`; // no-break space: a figure never splits from its unit

const SQ = 16, P = 20, INSET = (P - SQ) / 2;
const BX = 28, BY = 240, BIN_COLS = 10;
const TX = 300, TRUCK_COLS = 8;
const FX = 40, FIELD_COLS = 24;
const GY = 176; // field ground; the sown squares sit in the topsoil between GY and BY
const SPEED = 200; // tractor speed, units per second
const T0 = -140; // hopper x when the tractor sets off, the whole tractor still left of the picture
const DRIVE = 840; // distance the tractor drives, until it has left on the right
const passMs = (x) => Math.round(((x - T0) / SPEED) * 1000); // when the hopper is over x
// Field in the topsoil: rows run down from just under the ground.
const sown = (n) => ({ x: FX + (n % FIELD_COLS) * P + INSET, y: GY + 10 + Math.floor(n / FIELD_COLS) * P + INSET });
const DROP = 120; // how far above the bin the squares start before the fill; the picture clips, so the top rows fall in from its edge
const at = (x0, cols, n) => ({ x: x0 + (n % cols) * P + INSET, y: BY - (Math.floor(n / cols) + 1) * P + INSET });

// Bottom-up, oldest layer first. Each layer is its biochar squares with its water squares spread evenly
// through them; index i is the square's place in the full bin.
const layerSquares = (l, k) => {
  const dry = Math.round(l.dry / KG_PER_SQ);
  const wet = Math.round(waterOf(l.dry) / KG_PER_SQ);
  const len = dry + wet;
  const waterAt = new Set(Array.from({ length: wet }, (_, w) => Math.floor(((w + 0.5) * len) / wet)));
  return Array.from({ length: len }, (_, n) => (waterAt.has(n) ? "w" : `l${k + 1}`));
};
const seq = [l1, l2, l3].flatMap(layerSquares);
// The draw takes squares from the bottom until it holds DRAW of biochar; the water among them goes too.
let drawnN = 0;
for (let dry = 0; dry < DRAW / KG_PER_SQ; drawnN++) if (seq[drawnN] !== "w") dry++;
const squares = seq.map((kind, i) => {
  const full = at(BX, BIN_COLS, i);
  const drawn = i < drawnN;
  const after = drawn ? at(TX, TRUCK_COLS, i) : at(BX, BIN_COLS, i - drawnN);
  const field = drawn ? sown(i) : after; // what stays in the bin fades out in place
  const sow = passMs(field.x + SQ / 2);
  return { kind, drawn, style: `--i:${i};--x1:${full.x};--y1:${full.y};--x0:${full.x};--y0:${full.y - DROP};--x2:${after.x};--y2:${after.y};--x3:${field.x};--y3:${field.y};--sow:${sow}ms` };
});
// Crop row: one plant over every second gap between columns, so its root runs down a gap. Heights vary.
const HEIGHTS = [34, 42, 30, 46, 38, 32, 44, 36, 40, 30, 42, 34];
const plants = HEIGHTS.map((h, k) => {
  const x = FX + P * (2 * k + 1);
  // Leaves leave the stem rising, arch over and droop at the tip, alternating sides and shorter up the stem.
  const leaves = [0.3, 0.55, 0.78].map((f, j) => {
    const y = GY - h * f, d = j % 2 ? -1 : 1, w = 15 + (h % 5) - j * 3;
    return `M${x} ${y}C${x + d * 3} ${y - 9} ${x + d * w * 0.7} ${y - 11} ${x + d * w} ${y - 1}`;
  }).join("");
  const r = 40 + (h % 7);
  return {
    stem: `M${x} ${GY}V${GY - h}l${-3} ${-6}M${x} ${GY - h}l${3} ${-6}${leaves}`,
    root: `M${x} ${GY}V${GY + r}M${x} ${GY + 12}l-7 11M${x} ${GY + 22}l6 10M${x} ${GY + r - 8}l-4 7`,
    t: passMs(x) + 300,
  };
});
const PEBBLES = [[58, 230], [131, 234], [207, 229], [266, 235], [338, 231], [402, 234], [471, 229], [524, 233]];
const TOP = BY - (Math.ceil(seq.length / BIN_COLS) + 1) * P; // bin walls rise one row above the full bin

const STEPS = [
  {
    key: "fill", name: "Fill", num: kg(TOTAL), label: "dry biochar in bin A",
    text: `Each production run lands as its own layer, with its date and dry weight. The biochar comes in wet: at ${M}% moisture, the bin also holds ${kg(WATER_IN)} of water.`,
    rows: [
      ...[l1, l2, l3].map((l, k) => ({ sw: `l${k + 1}`, name: l.date, v: kg(l.dry) })),
      { sw: "w", name: "Water", v: kg(WATER_IN) },
    ],
  },
  {
    key: "draw", name: "Draw", num: kg(DRAW), label: "dry biochar drawn",
    text: `Bin A draws the oldest layer first (FIFO): all of ${l1.date}, then part of ${l2.date}. The water in it goes along: ${kg(WATER)}.`,
    rows: [{ sw: "l1", name: l1.date, v: kg(FROM_L1) }, { sw: "l2", name: l2.date, v: kg(FROM_L2) }, { sw: "w", name: "Water", v: kg(WATER) }],
    aside: "Each bin has its own draw method: oldest first (FIFO), newest first (LIFO), or a share of every layer (mix). Need a different rule? We can set it up for your site.",
  },
  {
    key: "weigh", name: "Weigh", num: kg(WET), label: "on the weighbridge", lit: true,
    text: `The weighbridge weighs biochar and water together. noma subtracts the ${M}% moisture and takes ${kg(DRAW)} of dry biochar off the bin’s stock.`,
    rows: [{ sw: "dry", name: "Dry biochar", v: kg(DRAW) }, { sw: "w", name: "Water", v: kg(WATER) }],
  },
  {
    key: "apply", name: "Apply", num: kg(DRAW), label: "dry biochar applied", lit: true,
    text: `A tractor spreads the load on Field 1, ${FIELD_HA} ha, and works it into the topsoil. noma records ${kg(DRAW)} of dry biochar applied, ${RATE} t per hectare, and traces every kilogram to its production run. The water goes on the field too, but only the dry biochar counts toward the carbon removal.`,
    rows: [{ sw: "l1", name: l1.date, v: kg(FROM_L1) }, { sw: "l2", name: l2.date, v: kg(FROM_L2) }, { sw: "w", name: "Water, not counted", v: kg(WATER) }],
  },
];
const LAST = STEPS.length;
---
<GridFrame id="bins" pad="none" flush aria-labelledby="bins-title">
  <div class="bs">
    <div class="pd-head">
      <h2 id="bins-title" class="t-h2">Know what’s in the bin.</h2>
      <p class="t-lead">noma records each production run that goes into a bin and each draw that leaves it. Step through one bin, from filling to the field.</p>
    </div>

    <div class="bs-stage" data-bs data-step={LAST}>
      <ol class="bs-tabs" aria-label="Steps" hidden>
        {STEPS.map((s, k) => (
          <li><button type="button" data-bs-go={k + 1} aria-current={k + 1 === LAST ? "step" : undefined}><span class="bs-n">{k + 1}</span>{s.name}</button></li>
        ))}
      </ol>

      <div class="bs-body">
        <div class="bs-panels" aria-live="polite">
          {STEPS.map((s, k) => (
            <section class="bs-panel" data-bs-panel={k + 1} aria-label={`Step ${k + 1}, ${s.name}`}>
              <p class:list={["bs-num", s.lit && "is-lit"]}>{s.num}</p>
              <p class:list={["bs-label", s.lit && "is-lit"]}>{s.label}</p>
              <p class="bs-text">{s.text}</p>
              <ul class="bs-rows">
                {s.rows.map((r) => <li><span class={`bs-sw bs-sw--${r.sw}`} aria-hidden="true"></span><span>{r.name}</span><span class="bs-v">{r.v}</span></li>)}
              </ul>
              {s.aside && <p class="bs-aside">{s.aside}</p>}
            </section>
          ))}
        </div>

        <svg class="bs-art" viewBox="0 0 560 300" aria-hidden="true">
          <text class="bs-cap bs-bin" x={BX + (BIN_COLS * P) / 2} y={BY + 30} text-anchor="middle">Bin A</text>
          <g class="bs-field">
            <circle class="bs-dim" cx="500" cy="62" r="16" />
            <path class="bs-dim" d={`M0 ${GY - 58}C120 ${GY - 92} 230 ${GY - 46} 340 ${GY - 66}S500 ${GY - 92} 560 ${GY - 64}`} />
            {plants.map((p) => <path class="bs-root" pathLength="1" d={p.root} style={`--t:${p.t}ms`} />)}
            <path class="bs-line" d={`M0 ${GY}H560`} />
            <path class="bs-soil" d={`M0 ${BY}H560`} />
            {PEBBLES.map(([x, y]) => <ellipse class="bs-dim" cx={x} cy={y} rx="3" ry="2" />)}
            {plants.map((p) => <path class="bs-plant" pathLength="1" d={p.stem} style={`--t:${p.t}ms`} />)}
            <text class="bs-cap" x={FX - 2} y={BY + 30}>Field 1, {FIELD_HA} ha</text>
          </g>
          <text class="bs-read bs-field-read" x={FX + FIELD_COLS * P + 2} y={BY + 50} text-anchor="end" style={`--t:${passMs(560)}ms`}>{kg(DRAW)} dry</text>
          <g class="bs-tractor" style={`--drive:${(DRIVE / SPEED) * 1000}ms;--dist:${DRIVE}`}>
            <g transform={`translate(${T0} 0)`}>
              <path class="bs-line" d={`M-16 ${GY - 36}H16L10 ${GY - 16}H-10ZM-18 ${GY - 16}H42M-10 ${GY - 16}L-12 ${GY + 6}M0 ${GY - 16}L-2 ${GY + 6}M10 ${GY - 16}L8 ${GY + 6}`} />
              <path class="bs-line" d={`M44 ${GY - 30}V${GY - 66}H80V${GY - 34}H128L134 ${GY - 26}V${GY - 14}H${82}M48 ${GY - 60}H76V${GY - 40}H48ZM112 ${GY - 34}V${GY - 50}M38 ${GY - 20}A22 22 0 0 1 82 ${GY - 20}`} />
              <circle class="bs-wheel" cx="60" cy={GY - 18} r="18" />
              <circle class="bs-tread" cx="60" cy={GY - 18} r="14" style="--rev:565ms" />
              <circle class="bs-wheel" cx="120" cy={GY - 10} r="10" />
              <circle class="bs-tread" cx="120" cy={GY - 10} r="6" style="--rev:314ms" />
            </g>
          </g>
          <g class="bs-truck">
            <path class="bs-line" d={`M${TX - 14} ${BY}H534V${BY - 30}L508 ${BY - 56}H478V${BY}`} />
            <circle class="bs-wheel" cx={TX + 16} cy={BY + 12} r="10" />
            <circle class="bs-wheel" cx={TX + 144} cy={BY + 12} r="10" />
            <circle class="bs-wheel" cx="514" cy={BY + 12} r="10" />
          </g>
          <g class="bs-scale">
            <path class="bs-line" d={`M${TX - 24} ${BY + 23}H544`} />
            <text class="bs-read" x="544" y={BY + 50} text-anchor="end">{kg(WET)}</text>
          </g>
          {squares.map((s) => <rect class:list={["bs-sq", `bs-sq--${s.kind}`, s.drawn && "is-drawn"]} width={SQ} height={SQ} style={s.style} />)}
          <path class="bs-line bs-bin" d={`M${BX - 2} ${TOP}V${BY}H${BX + BIN_COLS * P + 2}V${TOP}`} />
        </svg>
      </div>

      <div class="bs-foot">
        <p class="bs-note">One square is {kg(KG_PER_SQ)} of biochar or water. Illustrative records.</p>
        <div class="bs-nav" hidden>
          <button type="button" class="bs-back" data-bs-back>Back</button>
          <button type="button" class="btn btn--stage" data-bs-next>Next</button>
        </div>
      </div>
    </div>
  </div>
</GridFrame>
<script>import "./bins-steps.js";</script>

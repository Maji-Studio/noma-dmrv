---
/** MapSection (#map): the shared map visual (data-visual="map"), square and edge to edge. No props. */
import GridFrame from "../GridFrame.astro";
---
<GridFrame id="map" pad="none" flush aria-labelledby="map-title">
  <div class="pd-head">
    <h2 id="map-title" class="t-h2">See where it went.</h2>
    <p class="t-lead">Connect suppliers, production and application sites. Select a field to trace its sources, or a supplier to see the destinations.</p>
  </div>
  <div class="pd-panel pd-map">
    <p class="pd-hint">Swipe across the map to see every site.</p>
    <div data-visual="map" data-side="right"></div>
  </div>
</GridFrame>

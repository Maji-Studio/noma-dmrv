---
/**
 * ChapterHead: opens one Product chapter (PRODUCT_SECTIONS in src/config.js). The chapter name as a
 * display heading and one lead on the rose band, then a Mafinga still across the frame that shows what the
 * chapter is about. The chapter id goes here, so the sticky index lands on the head.
 * Props: id: string, title: string, lead: string,
 *        photo?: keyof PHOTOS, caption?: string, photoY?: string (object-position y, default "50%")
 */
import GridFrame from "../GridFrame.astro";
import Photo from "../Photo.astro";
import type { PHOTOS } from "../../../lib/assets.js";
interface Props { id: string; title: string; lead: string; photo?: keyof typeof PHOTOS; caption?: string; photoY?: string }
const { id, title, lead, photo, caption, photoY = "50%" } = Astro.props;
---
<GridFrame id={id} tone="rose" pad="none" flush class="ch" aria-labelledby={`${id}-title`}>
  <div class="ch-in">
    <h2 id={`${id}-title`} class="t-display ch-title">{title}</h2>
    <p class="t-lead ch-lead">{lead}</p>
  </div>
  {photo && (
    <figure class="photo-wide" style={`--photo-y:${photoY}`}>
      <Photo photo={photo} />
      {caption && <figcaption class="t-caption">{caption}</figcaption>}
    </figure>
  )}
</GridFrame>
<style>
  .ch-in { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-areas: "title lead"; gap: var(--space-5) var(--gap); align-items: end; padding: var(--space-9) var(--frame-pad) var(--space-8); }
  .ch-title { grid-area: title; margin: 0; max-width: 12ch; }
  .ch-lead { grid-area: lead; margin: 0; }
  @media (max-width: 760px) { .ch-in { grid-template-columns: minmax(0, 1fr); grid-template-areas: "title" "lead"; padding-block: var(--space-8) var(--space-7); } }
</style>

---
// Secondary action: underlined text link. The underline thickens and lifts on hover.
interface Props { href: string; [attr: string]: unknown }
const { href, ...rest } = Astro.props;
---
<a class="text-link" href={href} {...rest}><slot /></a>
<style>
  .text-link { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--acc-dist-ink); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; transition: text-underline-offset 0.2s var(--ease), text-decoration-thickness 0.2s var(--ease); }
  .text-link:hover, .text-link:focus-visible { text-decoration-thickness: 2px; text-underline-offset: 9px; }
</style>

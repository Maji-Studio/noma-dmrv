---
// Secondary action: underlined text link.
const { href, ...rest } = Astro.props;
---
<a class="text-link" href={href} {...rest}><slot /></a>
<style>
  .text-link { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--acc-dist-ink); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .text-link:hover { text-decoration-thickness: 2px; }
</style>

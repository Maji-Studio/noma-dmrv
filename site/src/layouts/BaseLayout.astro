---
import "../styles/tokens.css";
import "../visuals/visuals.css";
import PrototypeSwitcher from "../components/prototype/PrototypeSwitcher.astro";
// `layout` (PROTOTYPE ONLY): the variant key; sets data-layout on <html> and renders the switcher.
const { title, description, layout = "0" } = Astro.props;
---
<!doctype html>
<html lang="en" data-layout={layout}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body id="top">
    <slot />
    <PrototypeSwitcher current={layout} />
    <script>
      import { mountVisuals } from "../visuals/index.js";
      mountVisuals();
    </script>
  </body>
</html>

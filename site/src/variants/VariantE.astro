---
// PROTOTYPE variant E, "Removal dossier": the page as the evidence document behind one removal.
import { copy } from "../content/copy.js";
import WalkthroughForm from "../components/WalkthroughForm.astro";
const c = copy;
const REC = "RM-2026-004";
const toc = [
  ["ve-summary", "Summary"], ["trace", "Sources"], ["features", "Production"], ["ve-stock", "Stock"],
  ["ve-distribution", "Distribution"], ["ve-evidence", "Evidence"], ["registry", "Submission"],
  ["open-source", "Open source"], ["walkthrough", "Contact"],
];
const shipped = c.features.shipped.map(([, , t, x], i) => ["S" + (i + 1), t, x, "Shipped"]);
const upcoming = c.features.upcoming.map(([, , t, x], i) => ["U" + (i + 1), t, x, c.features.upcomingLabel]);
const register = [...shipped, ...upcoming];
---
<div class="ve">
  <nav class="ve-nav" aria-label="Main">
    <span class="ve-logo"><b>{c.brand.name}</b><span>{c.brand.by}</span></span>
    <a class="ve-btn ve-btn-sm" href={c.cta.primaryHref}>{c.cta.primary}</a>
  </nav>

  <header class="ve-cover">
    <div class="ve-cover-main">
      <h1>{c.hero.title}</h1>
      <p class="ve-lead">{c.hero.lead}</p>
      <div><a class="ve-btn ve-btn-lg" href={c.cta.primaryHref}>{c.cta.primary}</a></div>
    </div>
    <dl class="ve-docblock">
      <div><dt>Record</dt><dd>{REC}</dd></div>
      <div><dt>Facility</dt><dd>Mafinga, Tanzania</dd></div>
      <div><dt>Status</dt><dd>Assembled from plant records</dd></div>
      <div><dt>Data model</dt><dd>Isometric</dd></div>
      <div><dt>Example data</dt><dd>Made up</dd></div>
    </dl>
  </header>

  <div class="ve-doc">
    <aside class="ve-toc" aria-label="Contents">
      <p class="ve-toc-h">Contents</p>
      <ol>{toc.map(([id, t], i) => <li><a href={"#" + id} data-toc={id}><span>{i + 1}</span>{t}</a></li>)}</ol>
    </aside>

    <main class="ve-main">
      <section class="ve-sec" id="ve-summary" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>1 of 9</dd></div><div><dt>Record</dt><dd>{REC}</dd></div><div><dt>Chain</dt><dd>14 records</dd></div><div><dt>Applied</dt><dd>21 Sep 2026</dd></div></dl>
          <div class="ve-body">
            <h2>Summary</h2>
            <p class="ve-lead">One removal, followed from a sawmill to a coffee field near Mbeya. Select any square to see what it came from and what it became.</p>
          </div>
        </div>
        <figure class="ve-ex"><figcaption><b>Exhibit 1.</b> Chain of custody for {REC}</figcaption><div data-visual="chain"></div></figure>
        <div class="ve-two">
          <div>
            <h3>{c.proof.label}</h3>
            <ul class="ve-logos">{c.proof.logos.map((l) => <li>{l}</li>)}</ul>
          </div>
          <dl class="ve-figs">{c.proof.figures.map((f) => <div><dt>{f.value}</dt><dd>{f.text}</dd></div>)}</dl>
        </div>
      </section>

      <section class="ve-sec" id="trace" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>2 of 9</dd></div><div><dt>Delivery</dt><dd>FD-2026-001</dd></div><div><dt>Received</dt><dd>2,000 kg wet</dd></div><div><dt>Moisture</dt><dd>20%</dd></div><div><dt>Dry</dt><dd>1,600 kg</dd></div></dl>
          <div class="ve-body">
            <h2>Sources</h2>
            <p class="ve-lead">{c.dense.title} {c.dense.lead}</p>
          </div>
        </div>
        <figure class="ve-ex"><figcaption><b>Exhibit 2.</b> Six weeks of records behind the same removal</figcaption><div data-visual="dense" data-jump="true"></div></figure>
      </section>

      <section class="ve-sec" id="features" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>3 of 9</dd></div><div><dt>Run</dt><dd>PR-2026-043</dd></div><div><dt>Feedstock in</dt><dd>1,000 kg at 20%</dd></div><div><dt>Biochar out</dt><dd>300 kg at 10%</dd></div><div><dt>Energy</dt><dd>24 kWh, 14 L diesel</dd></div></dl>
          <div class="ve-body">
            <h2>Production</h2>
            <p class="ve-lead">{c.features.title} {c.features.lead}</p>
          </div>
        </div>
        <div class="ve-tblwrap">
          <p class="ve-tcap"><b>Table 1.</b> Feature register</p>
          <table class="ve-tbl">
            <thead><tr><th>Ref</th><th>Feature</th><th>What it records</th><th>Status</th></tr></thead>
            <tbody>{register.map(([ref, t, x, s]) => <tr>
              <td data-l="Ref" class="ve-mono">{ref}</td><td data-l="Feature"><b>{t}</b></td><td data-l="What it records">{x}</td>
              <td data-l="Status"><span class:list={["ve-chip", s === "Shipped" ? "ve-ok" : "ve-up"]}>{s}</span></td></tr>)}</tbody>
          </table>
        </div>
        <div class="ve-tblwrap">
          <p class="ve-tcap"><b>Table 2.</b> {c.compare.title}</p>
          <table class="ve-tbl ve-cmp">
            <thead><tr><th>Question</th>{c.compare.columns.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>{c.compare.rows.map(([a, b, d]) => <tr><td data-l="Question"><b>{a}</b></td><td data-l={c.compare.columns[0]} class="ve-dim">{b}</td><td data-l={c.compare.columns[1]}>{d}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="ve-sec" id="ve-stock" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>4 of 9</dd></div><div><dt>Bin</dt><dd>Bin A, layer 3</dd></div><div><dt>Dry biochar</dt><dd>270 kg</dd></div><div><dt>Draw order</dt><dd>Oldest layer first</dd></div></dl>
          <div class="ve-body">
            <h2>{c.features.bins.title}</h2>
            <p class="ve-lead">{c.features.bins.text}</p>
          </div>
        </div>
        <figure class="ve-ex"><figcaption><b>Exhibit 3.</b> Bin draws, split and mix. {c.features.bins.hint}</figcaption><div data-visual="bins"></div></figure>
      </section>

      <section class="ve-sec" id="ve-distribution" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>5 of 9</dd></div><div><dt>Delivery</dt><dd>DL-2026-012</dd></div><div><dt>Route</dt><dd>Mafinga to Mbeya, 240 km</dd></div><div><dt>Departure moisture</dt><dd>15%</dd></div></dl>
          <div class="ve-body">
            <h2>{c.map.title}</h2>
            <p class="ve-lead">{c.map.lead}</p>
          </div>
        </div>
        <figure class="ve-ex"><figcaption><b>Exhibit 4.</b> Suppliers, plant and fields, Southern Highlands (illustrative points)</figcaption><div data-visual="map"></div></figure>
      </section>

      <section class="ve-sec" id="ve-evidence" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>6 of 9</dd></div><div><dt>Credit batch</dt><dd>CB-2026-043</dd></div><div><dt>Samples</dt><dd>3 replicates</dd></div><div><dt>Organic carbon</dt><dd>76%</dd></div></dl>
          <div class="ve-body">
            <h2>Evidence</h2>
            <p class="ve-lead">Weighbridge tickets, bills of lading, lab reports and photos stay attached to the record they prove. Three views of the same data follow.</p>
          </div>
        </div>
        <div class="ve-shots">{c.dense.screenshots.map((s, i) => <figure class="ve-ex ve-shot"><div class="ve-shot-ph">Screenshot to come</div><figcaption><b>Exhibit {5 + i}.</b> {s}</figcaption></figure>)}</div>
      </section>

      <section class="ve-sec" id="registry" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>7 of 9</dd></div><div><dt>Bundle</dt><dd>{REC}</dd></div><div><dt>Contains</dt><dd>Sources, datapoints, GHG entry</dd></div></dl>
          <div class="ve-body">
            <h2>Submission</h2>
            <p class="ve-lead">{c.registry.title} {c.registry.lead}</p>
          </div>
        </div>
        <figure class="ve-ex"><figcaption><b>Exhibit 8.</b> noma fields mapped onto Isometric fields, then bundled as {REC}</figcaption><div data-visual="morph"></div></figure>
      </section>

      <section class="ve-sec" id="open-source" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>8 of 9</dd></div><div><dt>Licence</dt><dd>MIT</dd></div><div><dt>Stack</dt><dd>Postgres, Next.js</dd></div></dl>
          <div class="ve-body"><h2>{c.openSource.title}</h2></div>
        </div>
        <dl class="ve-choice">{c.openSource.cards.map((k) => <div>
          <dt><span class="ve-chip ve-plain">{k.chip}</span> {k.title}</dt>
          <dd><p>{k.text}</p><a class="ve-btn" href={k.href}>{k.action}</a></dd></div>)}</dl>
      </section>

      <section class="ve-sec" id="walkthrough" data-sec>
        <div class="ve-head">
          <dl class="ve-meta"><div><dt>Section</dt><dd>9 of 9</dd></div><div><dt>Reply</dt><dd>By email</dd></div></dl>
          <div class="ve-body"><h2>{c.walkthrough.title}</h2><p class="ve-lead">{c.walkthrough.lead}</p></div>
        </div>
        <div class="ve-form"><WalkthroughForm idPrefix="ve" /></div>
      </section>

      <footer class="ve-foot"><span>{c.footer.left}</span><span>{c.footer.right} <a href={c.cta.githubHref}>GitHub</a></span></footer>
    </main>
  </div>
</div>

<style>
  .ve { max-width: 1320px; margin: 0 auto; padding-inline: 20px; }
  .ve-mono, .ve-meta, .ve-docblock, .ve-toc li span { font-family: var(--f-mono); }
  .ve-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 16px; border-bottom: 1px solid var(--hair-strong); }
  .ve-logo { display: flex; align-items: baseline; gap: 7px; }
  .ve-logo b { font-size: 24px; letter-spacing: -0.02em; }
  .ve-logo span { font-size: 13px; color: var(--ink-3); }
  .ve-btn { display: inline-block; border: 1.5px solid var(--ink); border-radius: 2px; padding: 9px 16px; font-weight: 700; font-size: 15px; text-decoration: none; background: var(--paper); }
  .ve-btn-lg { background: var(--ink); color: var(--paper); padding: 13px 22px; font-size: 17px; }
  .ve-btn-sm { padding: 7px 12px; font-size: 13px; background: var(--ink); color: var(--paper); }
  .ve h1 { font-size: clamp(38px, 6.4vw, 88px); letter-spacing: -0.04em; line-height: 0.98; max-width: 16ch; }
  .ve h2 { font-size: clamp(28px, 3.4vw, 44px); letter-spacing: -0.03em; }
  .ve h3 { font-size: 16px; }
  .ve-lead { font-size: clamp(17px, 1.5vw, 20px); color: var(--ink-2); max-width: 62ch; }

  .ve-cover { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 40px; align-items: end; padding-block: 64px 48px; border-bottom: 1px solid var(--hair-strong); }
  .ve-cover-main { display: grid; gap: 26px; justify-items: start; }
  .ve-docblock { margin: 0; border-top: 2px solid var(--ink); font-size: 12.5px; }
  .ve-docblock div { display: grid; grid-template-columns: 96px 1fr; gap: 10px; padding-block: 9px; border-bottom: 1px solid var(--hair); }
  .ve-docblock dt { color: var(--ink-3); }
  .ve-docblock dd { margin: 0; }

  .ve-doc { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 48px; align-items: start; }
  .ve-toc { position: sticky; top: 20px; padding-block: 40px; }
  .ve-toc-h { font-weight: 700; font-size: 14px; margin-bottom: 10px; }
  .ve-toc ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--hair-2); }
  .ve-toc a { display: flex; gap: 10px; padding: 5px 0 5px 12px; margin-left: -1px; border-left: 2px solid transparent; text-decoration: none; font-size: 14px; color: var(--ink-2); }
  .ve-toc li span { width: 1ch; font-size: 12px; color: var(--ink-3); }
  .ve-toc a[aria-current="true"] { border-left-color: var(--accent); color: var(--ink); font-weight: 700; }
  .ve-toc a:hover { color: var(--ink); }

  .ve-main { min-width: 0; }
  .ve-sec { padding-block: 56px; border-bottom: 1px solid var(--hair-2); display: grid; gap: 30px; scroll-margin-top: 8px; }
  .ve-head { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 32px; align-items: start; }
  .ve-body { display: grid; gap: 14px; min-width: 0; }
  .ve-meta { margin: 0; font-size: 12px; line-height: 1.45; display: grid; gap: 8px; border-top: 2px solid var(--ink); padding-top: 10px; }
  .ve-meta dt { color: var(--ink-3); }
  .ve-meta dd { margin: 0; overflow-wrap: anywhere; }

  .ve-ex { margin: 0; display: grid; gap: 10px; min-width: 0; }
  .ve-ex figcaption { font-size: 14px; color: var(--ink-2); max-width: 90ch; }
  .ve-ex figcaption b { color: var(--ink); }

  .ve-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
  .ve-logos { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ve-logos li { border: 1px dashed var(--hair-2); padding: 8px 14px; font-weight: 700; font-size: 14px; color: var(--ink-2); background: var(--paper); }
  .ve-figs { margin: 0; display: grid; gap: 12px; }
  .ve-figs div { display: grid; grid-template-columns: 110px 1fr; gap: 14px; align-items: baseline; border-top: 1px solid var(--hair); padding-top: 10px; }
  .ve-figs dt { font-weight: 700; font-size: 22px; letter-spacing: -0.02em; }
  .ve-figs dd { margin: 0; font-size: 14px; color: var(--ink-2); }

  .ve-tblwrap { display: grid; gap: 8px; }
  .ve-tcap { font-size: 14px; color: var(--ink-2); }
  .ve-tcap b { color: var(--ink); }
  .ve-tbl { border-collapse: collapse; width: 100%; font-size: 15px; background: var(--paper); border-top: 2px solid var(--ink); }
  .ve-tbl th { text-align: left; font-size: 13px; color: var(--ink-3); font-weight: 700; padding: 10px 14px; border-bottom: 1px solid var(--hair-strong); }
  .ve-tbl td { padding: 11px 14px; border-bottom: 1px solid var(--hair); vertical-align: top; }
  .ve-tbl td:nth-child(3) { color: var(--ink-2); }
  .ve-tbl .ve-mono { font-size: 12.5px; color: var(--ink-3); width: 56px; }
  .ve-cmp td:nth-child(2) { color: var(--ink-3); }
  .ve-cmp td:nth-child(3) { color: var(--ink); font-weight: 700; }
  .ve-cmp td:first-child { width: 30%; }
  .ve-chip { display: inline-block; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 2px 10px; white-space: nowrap; }
  .ve-ok { background: var(--ver-bg); color: var(--ver); }
  .ve-up { background: var(--infra-bg); color: var(--infra); }
  .ve-plain { background: var(--off-bg); color: var(--ink-2); }

  .ve-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .ve-shot-ph { aspect-ratio: 16/10; display: grid; place-items: center; font-size: 13px; color: var(--ink-3); border: 1px solid var(--hair-2); background: repeating-linear-gradient(135deg, var(--sea) 0 10px, transparent 10px 20px); }

  .ve-choice { margin: 0; display: grid; border-top: 2px solid var(--ink); }
  .ve-choice > div { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 32px; padding-block: 18px; border-bottom: 1px solid var(--hair); }
  .ve-choice dt { font-weight: 700; font-size: 20px; display: grid; gap: 8px; justify-items: start; }
  .ve-choice dd { margin: 0; display: grid; gap: 14px; justify-items: start; color: var(--ink-2); max-width: 62ch; }

  .ve-form { max-width: 720px; margin-left: 222px; }
  .ve-form :global(.wt-form input), .ve-form :global(.wt-form select), .ve-form :global(.wt-form textarea), .ve-form :global(.wt-submit) { border-radius: 2px; }

  .ve-foot { padding-block: 28px 80px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; font-size: 13px; color: var(--ink-3); }

  @media (max-width: 960px) {
    .ve-cover { grid-template-columns: 1fr; padding-block: 40px 32px; }
    .ve-doc { grid-template-columns: 1fr; gap: 0; }
    .ve-toc { position: static; padding-block: 20px 0; }
    .ve-toc ol { display: flex; flex-wrap: wrap; gap: 2px 14px; border-left: 0; }
    .ve-toc a { border-left: 0; border-bottom: 2px solid transparent; margin: 0; padding: 4px 0; }
    .ve-toc a[aria-current="true"] { border-bottom-color: var(--accent); }
  }
  @media (max-width: 760px) {
    .ve-sec { padding-block: 40px; }
    .ve-head, .ve-choice > div { grid-template-columns: 1fr; gap: 14px; }
    .ve-meta { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); }
    .ve-form { margin-left: 0; }
    .ve-tbl thead { position: absolute; left: -9999px; }
    .ve-tbl, .ve-tbl tbody, .ve-tbl tr, .ve-tbl td { display: block; }
    .ve-tbl tr { padding: 10px 14px; border-bottom: 1px solid var(--hair); }
    .ve-tbl td { border: 0; padding: 2px 0; width: auto !important; }
    .ve-tbl td[data-l]::before { content: attr(data-l) ": "; font-size: 12px; color: var(--ink-3); }
    .ve-tbl td:first-child[data-l="Ref"]::before { content: ""; }
    .ve-figs div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

<script>
  import { onShown } from "../lib/variant.js";
  onShown("E", (root) => {
    const links = new Map();
    root.querySelectorAll<HTMLAnchorElement>("[data-toc]").forEach((a) => links.set(a.dataset.toc, a));
    const mark = (id: string) => links.forEach((a, k) => (k === id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
    const secs = root.querySelectorAll<HTMLElement>("[data-sec]");
    if (secs[0]) mark(secs[0].id);
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) mark((e.target as HTMLElement).id); });
    }, { rootMargin: "-20% 0px -65% 0px" });
    secs.forEach((s) => io.observe(s));
  });
</script>

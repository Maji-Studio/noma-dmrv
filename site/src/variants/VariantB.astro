---
// PROTOTYPE variant B, "Follow one tonne": scroll-driven story. The simple trace stays pinned while
// nine chapters walk one tonne of biochar from the sawmill to the removal; each chapter pins its node.
import { copy } from "../content/copy.js";
import { featIcon } from "../visuals/core.js";
import WalkthroughForm from "../components/WalkthroughForm.astro";
const c = copy;
const shipped = c.features.shipped;
const F = (title) => shipped.find((f) => f[2] === title);

// Chapters in custody order (same ids as CHAIN_ORDER in visuals/data.js).
// New copy is only in `say` and the hero cue; features and visuals come from copy.js.
const chapters = [
  { id: "s1", name: "Sawmill", say: "It starts at a sawmill. noma records who supplied the wood waste and how far it travelled to the plant.", feats: [] },
  { id: "f1", name: "Delivery in", say: "The truck is weighed at the gate. Mass, moisture and the weighbridge ticket go on the delivery record.", feats: ["Upstream records"] },
  { id: "b1", name: "Feedstock bin", say: "The delivery is tipped into a feedstock bin. noma tracks wet mass in and out, withdrawn pro-rata.", feats: [] },
  { id: "r1", name: "Production run", say: "One run turns feedstock into biochar. In this made-up run, 1,000 kg goes in at 20% moisture and 300 kg comes out at 10%, so 270 kg dry.", feats: ["Dry and wet mass", "Energy per run"] },
  { id: "l1", name: "Biochar bin", say: "The biochar goes into a bin, where every movement is logged.", feats: [], bins: true },
  { id: "p1", name: "Product", say: "It leaves the bin as a product, plain or blended. The dry biochar inside stays counted.", feats: ["Feedstock and formulations"] },
  { id: "d1", name: "Delivery out", say: "The product goes on a truck. Departure moisture, distance and the bill of lading go on the delivery record.", feats: ["Evidence on every step"] },
  { id: "a1", name: "Field", say: "It is spread on a field, and the application keeps the field's boundary.", feats: ["Field boundaries"] },
  { id: "rm", name: "Removal", say: "The chain ends in a removal. Everything upstream is bundled into one submission.", feats: ["Readiness check", "Lab samples", "Mass balance"], morph: true },
];
const anchors = { r1: "features", rm: "registry" };
const cue = "Scroll to follow one tonne";
const upNext = "Five things we're building next";
---
<div class="bb">
  <nav class="bb-nav" aria-label="Main">
    <span class="bb-logo"><b>{c.brand.name}</b><span>{c.brand.by}</span></span>
    <span class="bb-links">{c.nav.map((n) => <a href={n.href}>{n.label}</a>)}</span>
    <a class="bb-btn bb-btn-pri bb-btn-sm" href={c.cta.primaryHref}>{c.cta.primary}</a>
  </nav>

  <header class="bb-hero">
    <h1>{c.hero.title}</h1>
    <p class="bb-lead">{c.hero.lead}</p>
    <div class="bb-ctas"><a class="bb-btn bb-btn-pri bb-btn-lg" href={c.cta.primaryHref}>{c.cta.primary}</a></div>
    <a class="bb-cue" href="#trace"><span class="bb-cue-line" aria-hidden="true"></span>{cue}</a>
  </header>

  <section class="bb-journey" id="trace" aria-label="One tonne of biochar, from sawmill to removal">
    <aside class="bb-rail">
      <div class="bb-trace"><div data-visual="chain" data-side="none" data-legend="false"></div></div>
      <p class="bb-cap"><span class="bb-cap-n"></span> <b class="bb-cap-name"></b></p>
      <ol class="bb-index">
        {chapters.map((ch, i) => <li><a href={`#b-ch-${ch.id}`} data-idx={i}><span class="bb-i">{i + 1}</span>{ch.name}</a></li>)}
      </ol>
      <div class="bb-card">
        <span class="bb-card-st"></span>
        <b class="bb-card-code"></b>
        <ul class="bb-card-meta"></ul>
      </div>
    </aside>

    <div class="bb-chapters">
      {chapters.map((ch, i) => (
        <article class="bb-ch" data-node={ch.id} id={anchors[ch.id] || undefined} data-anchor={`b-ch-${ch.id}`}>
          <header>
            <span class="bb-step">{i + 1} of {chapters.length}</span>
            <h2>{ch.name}</h2>
          </header>
          <p class="bb-say">{ch.say}</p>
          {ch.bins && (
            <div class="bb-block">
              <div class="bb-stack">
                <h3>{c.features.bins.title}</h3>
                <p class="bb-sub">{c.features.bins.text}</p>
                <p class="bb-hint">{c.features.bins.hint}</p>
              </div>
              <div data-visual="bins"></div>
            </div>
          )}
          {ch.morph && (
            <div class="bb-block">
              <div class="bb-stack">
                <h3>{c.registry.title}</h3>
                <p class="bb-sub">{c.registry.lead}</p>
              </div>
              <div data-visual="morph" data-autoplay="visible"></div>
            </div>
          )}
          {ch.feats.length > 0 && (
            <div class="bb-feats">
              {ch.feats.map((t) => { const [g, d, title, text] = F(t); return <div class="bb-feat"><Fragment set:html={featIcon(g, d)} /><div><h3>{title}</h3><p>{text}</p></div></div>; })}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="bb-sec" id="bb-messy">
    <h2>{c.dense.title}</h2>
    <p class="bb-lead">{c.dense.lead}</p>
    <div data-visual="dense" data-jump="true"></div>
    <div class="bb-shots">{c.dense.screenshots.map((s) => <div class="bb-shot"><div class="bb-shot-bar"><i></i><i></i><i></i></div><div class="bb-shot-ph">Screenshot: {s}</div></div>)}</div>
  </section>

  <section class="bb-sec">
    <h2>{c.map.title}</h2>
    <p class="bb-lead">{c.map.lead}</p>
    <div data-visual="map"></div>
  </section>

  <section class="bb-sec">
    <h2>{upNext}</h2>
    <div class="bb-grid">{c.features.upcoming.map(([g, d, t, x]) => <div class="bb-feat bb-up"><Fragment set:html={featIcon(g, d)} /><div><div class="bb-uph"><h3>{t}</h3><span class="bb-chip">{c.features.upcomingLabel}</span></div><p>{x}</p></div></div>)}</div>
  </section>

  <section class="bb-sec">
    <h2 class="bb-h-sm">{c.compare.title}</h2>
    <div class="bb-tbl"><table><thead><tr><th></th>{c.compare.columns.map((h) => <th>{h}</th>)}</tr></thead>
      <tbody>{c.compare.rows.map(([a, b, d]) => <tr><td>{a}</td><td>{b}</td><td>{d}</td></tr>)}</tbody></table></div>
  </section>

  <section class="bb-sec">
    <div class="bb-logos"><span class="bb-hint">{c.proof.label}</span>{c.proof.logos.map((l) => <span class="bb-logo-ph">{l}</span>)}</div>
    <p class="bb-fact">{c.proof.figures.map((f) => <span><b>{f.value}</b> {f.text}. </span>)}</p>
  </section>

  <section class="bb-sec" id="open-source">
    <h2>{c.openSource.title}</h2>
    <div class="bb-two">{c.openSource.cards.map((k) => <div class="bb-card2 bb-stack"><span class="bb-chip">{k.chip}</span><h3>{k.title}</h3><p class="bb-sub">{k.text}</p><div><a class="bb-btn" href={k.href}>{k.action}</a></div></div>)}</div>
  </section>

  <section class="bb-sec" id="walkthrough">
    <div class="bb-formgrid">
      <div class="bb-stack"><h2>{c.walkthrough.title}</h2><p class="bb-lead">{c.walkthrough.lead}</p></div>
      <div class="bb-card2"><WalkthroughForm idPrefix="bb" /></div>
    </div>
  </section>

  <footer class="bb-foot"><span>{c.footer.left}</span><span>{c.footer.right} <a href={c.cta.githubHref}>GitHub</a></span></footer>
</div>

<style>
  .bb { max-width: 1240px; margin: 0 auto; padding-inline: 20px; }
  .bb-nav { display: flex; align-items: center; gap: 22px; padding-block: 18px; flex-wrap: wrap; }
  .bb-logo { display: flex; align-items: baseline; gap: 7px; margin-right: auto; }
  .bb-logo b { font-size: 24px; letter-spacing: -0.02em; }
  .bb-logo span { font-size: 13px; color: var(--ink-3); }
  .bb-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .bb-links a { font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .bb a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .bb-hero { padding-block: 56px 44px; display: grid; gap: 24px; justify-items: start; }
  .bb h1 { font-size: clamp(40px, 7vw, 96px); letter-spacing: -0.04em; line-height: 0.98; max-width: 14ch; }
  .bb h2 { font-size: clamp(30px, 3.6vw, 50px); letter-spacing: -0.03em; line-height: 1.04; }
  .bb h3 { font-size: 17px; }
  .bb-lead { font-size: clamp(17px, 1.6vw, 21px); color: var(--ink-2); max-width: 58ch; }
  .bb-sub { color: var(--ink-2); }
  .bb-hint { font-size: 13px; color: var(--ink-3); }
  .bb-stack { display: grid; gap: 12px; align-content: start; }
  .bb-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .bb-btn { display: inline-block; border: 1.5px solid var(--ink); border-radius: 8px; padding: 9px 16px; font-weight: 700; font-size: 15px; text-decoration: none; background: var(--paper); }
  .bb-btn-pri { background: var(--ink); color: var(--paper); }
  .bb-btn-lg { padding: 13px 22px; font-size: 17px; }
  .bb-btn-sm { padding: 7px 12px; font-size: 13px; }
  .bb-cue { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; color: var(--ink-2); text-decoration: none; margin-top: 8px; }
  .bb-cue-line { width: 1.5px; height: 44px; background: var(--ink); display: block; transform-origin: top; }
  @media (prefers-reduced-motion: no-preference) { .bb-cue-line { animation: bb-drop 2.2s ease-in-out infinite; } }
  @keyframes bb-drop { 0% { transform: scaleY(0.15); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0.25; } }

  /* Journey: sticky trace rail plus chapters */
  .bb-journey { display: grid; grid-template-columns: minmax(0, 500px) minmax(0, 1fr); gap: 64px; align-items: start; border-top: 1px solid var(--hair); }
  .bb-rail { position: sticky; top: 24px; display: grid; gap: 16px; padding-block: 24px; }
  .bb-trace :global(.nv-scroll svg) { min-width: 0 !important; }
  .bb-trace :global(.nv-node text) { display: none; }
  .bb-trace :global(.nv-node.bb-later) { opacity: 0.2 !important; }
  .bb-trace :global(.nv-edge.bb-later) { opacity: 0.12 !important; stroke: var(--hair-2) !important; stroke-width: 1.2 !important; }
  .bb-cap { display: none; font-size: 14px; align-items: baseline; gap: 8px; }
  .bb-cap-n { font-family: var(--f-mono); font-weight: 500; font-size: 12px; color: var(--ink-3); }
  .bb-index { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .bb-index a { display: flex; align-items: baseline; gap: 12px; padding: 5px 8px; border-radius: 6px; font-size: 14px; color: var(--ink-3); text-decoration: none; }
  .bb-index a[aria-current="step"] { color: var(--ink); font-weight: 700; background: var(--paper); box-shadow: inset 3px 0 0 var(--accent); }
  .bb-i { font-family: var(--f-mono); font-weight: 500; font-size: 12px; width: 1.4em; }
  .bb-card { background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 10px; padding: 14px 16px; display: grid; gap: 4px; min-height: 118px; align-content: start; }
  .bb-card-st { font-size: 12px; color: var(--ink-3); }
  .bb-card-code { font-family: var(--f-mono); font-weight: 500; font-size: 15px; }
  .bb-card-meta { margin: 4px 0 0; padding: 0; list-style: none; display: grid; gap: 2px; font-size: 13.5px; color: var(--ink-2); }

  .bb-chapters { min-width: 0; }
  .bb-ch { padding-block: 72px 48px; min-height: 58svh; display: grid; gap: 20px; align-content: start; scroll-margin-top: 24px; border-top: 1px solid var(--hair); }
  .bb-ch:first-child { border-top: 0; }
  .bb-ch header { display: grid; gap: 6px; }
  .bb-step { font-family: var(--f-mono); font-weight: 500; font-size: 12px; color: var(--ink-3); }
  .bb-say { font-size: clamp(18px, 1.8vw, 22px); line-height: 1.4; max-width: 44ch; }
  .bb-block { display: grid; gap: 16px; background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 10px; padding: 22px; min-width: 0; }
  .bb-block h3 { font-size: 22px; letter-spacing: -0.02em; }
  .bb-feats, .bb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .bb-grid { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .bb-feat { background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 8px; padding: 16px; display: flex; gap: 12px; align-items: flex-start; min-width: 0; }
  .bb-feat :global(svg) { flex: none; }
  .bb-feat h3 { margin-bottom: 4px; }
  .bb-feat p { font-size: 14px; color: var(--ink-2); }
  .bb-up { background: var(--page); border-style: dashed; }
  .bb-uph { display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; margin-bottom: 4px; }
  .bb-uph h3 { margin: 0; }
  .bb-chip { display: inline-flex; justify-self: start; font-size: 11.5px; font-weight: 700; border-radius: 999px; padding: 2px 9px; background: var(--infra-bg); color: var(--infra); }

  /* After the journey */
  .bb-sec { padding-block: 72px; display: grid; gap: 26px; border-top: 1px solid var(--hair); scroll-margin-top: 20px; }
  .bb-h-sm { font-size: clamp(22px, 2.6vw, 32px) !important; }
  .bb-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .bb-shot { border: 1.5px solid var(--hair-2); border-radius: 8px; background: var(--paper); overflow: hidden; display: grid; grid-template-rows: auto 1fr; aspect-ratio: 16/10; }
  .bb-shot-bar { display: flex; gap: 5px; padding: 8px 10px; border-bottom: 1px solid var(--hair); }
  .bb-shot-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--hair-2); }
  .bb-shot-ph { display: grid; place-items: center; color: var(--ink-3); font-size: 13px; padding: 16px; text-align: center; background: repeating-linear-gradient(135deg, var(--sea) 0 10px, transparent 10px 20px); }
  .bb-tbl { overflow-x: auto; border: 1.5px solid var(--hair-2); border-radius: 10px; background: var(--paper); }
  .bb-tbl table { border-collapse: collapse; width: 100%; min-width: 620px; font-size: 15px; }
  .bb-tbl th { text-align: left; font-size: 12px; color: var(--ink-3); padding: 12px 16px; border-bottom: 1.5px solid var(--hair-strong); }
  .bb-tbl td { padding: 13px 16px; border-bottom: 1px solid var(--hair); vertical-align: top; }
  .bb-tbl td:first-child { font-weight: 700; width: 34%; }
  .bb-tbl td:nth-child(2) { color: var(--ink-3); }
  .bb-logos { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .bb-logo-ph { border: 1.5px dashed var(--hair-2); border-radius: 6px; padding: 10px 16px; font-weight: 700; color: var(--ink-2); font-size: 14px; background: var(--paper); }
  .bb-fact { font-size: 14px; color: var(--ink-2); }
  .bb-fact b { color: var(--ink); }
  .bb-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
  .bb-card2 { background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 10px; padding: 22px; min-width: 0; }
  .bb-two h3 { font-size: 22px; }
  .bb-formgrid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 32px; align-items: start; }
  .bb-foot { padding-block: 28px 90px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; font-size: 13px; color: var(--ink-3); border-top: 1px solid var(--hair); }

  /* Narrow: the rail becomes a compact strip pinned to the top of the viewport */
  @media (max-width: 900px) {
    .bb-journey { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .bb-rail { top: 0; z-index: 30; margin-inline: -20px; padding: 8px 20px 10px; gap: 6px; background: var(--page); border-bottom: 1.5px solid var(--hair-2); }
    .bb-index, .bb-card { display: none; }
    .bb-cap { display: flex; }
    .bb-ch { scroll-margin-top: calc(var(--bb-strip, 150px) + 12px); padding-block: 48px 32px; min-height: 0; }
    .bb-sec { padding-block: 48px; }
    .bb-formgrid { grid-template-columns: minmax(0, 1fr); }
    .bb-hero { padding-block: 32px; }
  }
</style>

<script>
  import { onShown } from "../lib/variant.js";

  // Ids that are not chapters but belong to a step: the manure branch joins at Product, credit batch and sample at Removal.
  const JOINS = { s2: "p1", f2: "p1", i1: "p1", cb: "rm", sm: "rm" };

  onShown("B", (root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const chain = root.querySelector('[data-visual="chain"]') as any;
    const ctl = chain.noma;
    const rail = root.querySelector(".bb-rail") as HTMLElement;
    const chapters = [...root.querySelectorAll(".bb-ch")] as HTMLElement[];
    const ids = chapters.map((c) => c.dataset.node as string);
    const links = [...root.querySelectorAll(".bb-index a")] as HTMLElement[];
    const capN = root.querySelector(".bb-cap-n") as HTMLElement;
    const capName = root.querySelector(".bb-cap-name") as HTMLElement;
    const card = { st: root.querySelector(".bb-card-st") as HTMLElement, code: root.querySelector(".bb-card-code") as HTMLElement, meta: root.querySelector(".bb-card-meta") as HTMLElement };
    const svg = chain.querySelector("svg") as SVGElement;
    const stepOf = (id: string) => { const k = ids.indexOf(JOINS[id] || id); return k; };
    let current = -1;

    const setChapter = (i: number) => {
      if (i === current || i < 0) return;
      current = i;
      ctl.pin(ids[i]);
      // "So far": dim everything downstream of this chapter that pin() would otherwise light up.
      svg.querySelectorAll(".nv-node").forEach((n) => n.classList.toggle("bb-later", stepOf(n.getAttribute("data-id") as string) > i));
      svg.querySelectorAll(".nv-edge").forEach((e: any) => e.classList.toggle("bb-later", stepOf(e._b) > i));
      links.forEach((a, k) => (k === i ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
      capN.textContent = `${i + 1} of ${ids.length}`;
      capName.textContent = (chapters[i].querySelector("h2") as HTMLElement).textContent;
    };

    // Detail card follows whatever the trace reports (pinned chapter, or a clicked node).
    chain.addEventListener("noma:select", (e: any) => {
      const n = e.detail && e.detail.node;
      if (!n) return;
      card.st.textContent = n.short || "";
      card.code.textContent = n.code;
      card.meta.innerHTML = "";
      (n.meta || []).forEach((m: string) => { const li = document.createElement("li"); li.textContent = m; card.meta.appendChild(li); });
    });

    const goTo = (target: Element | null) => {
      if (target) target.scrollIntoView({ behavior: reduce.matches ? "auto" : "smooth", block: "start" });
    };
    // Clicking a chapter node in the trace jumps to its chapter.
    chain.addEventListener("click", (e: any) => {
      const n = e.target.closest && e.target.closest("[data-id]");
      if (!n) return;
      const k = ids.indexOf(n.getAttribute("data-id"));
      if (k < 0) return;
      current = -1; setChapter(k);
      goTo(chapters[k]);
    });

    // Anchors: the page holds several variants, so resolve hashes inside this one.
    root.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        const href = a.getAttribute("href") as string;
        const t = root.querySelector(href) || root.querySelector(`[data-anchor="${href.slice(1)}"]`);
        if (!t) return;
        e.preventDefault();
        goTo(t);
      });
    });

    // Keep the scroll offset in step with the pinned strip on narrow screens.
    const measure = () => root.style.setProperty("--bb-strip", `${rail.offsetHeight}px`);
    new ResizeObserver(measure).observe(rail);
    measure();

    setChapter(0);
    const io = new IntersectionObserver((entries) => {
      let hit = -1;
      entries.forEach((en) => { if (en.isIntersecting) hit = Math.max(hit, chapters.indexOf(en.target as HTMLElement)); });
      if (hit >= 0) setChapter(hit);
    }, { rootMargin: "-38% 0px -57% 0px", threshold: 0 });
    chapters.forEach((c) => io.observe(c));
  });
</script>

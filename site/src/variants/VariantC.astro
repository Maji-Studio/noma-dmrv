---
// PROTOTYPE variant C, "Map first": the page is told as a place. Map hero, then zoom in to one field, then the whole plant.
import { copy } from "../content/copy.js";
import { featIcon } from "../visuals/core.js";
import WalkthroughForm from "../components/WalkthroughForm.astro";
const c = copy;
const places = [
  ["Suppliers", "Sawmills around Mafinga, each with its haul distance"],
  ["The plant", "Mafinga, where production, bins and blending happen"],
  ["Fields", "Near Mbeya, Njombe, Makambako and Iringa"],
];
---
<div class="vc">
  <nav class="vc-nav" aria-label="Main">
    <span class="vc-logo"><b>{c.brand.name}</b><span>{c.brand.by}</span></span>
    <span class="vc-links">{c.nav.map((n) => <a href={n.href}>{n.label}</a>)}</span>
    <a class="vc-btn vc-btn-pri vc-btn-sm" href={c.cta.primaryHref}>{c.cta.primary}</a>
  </nav>

  <header class="vc-hero">
    <div class="vc-panel">
      <h1>{c.hero.title}</h1>
      <p class="vc-lead">{c.hero.lead}</p>
      <div><a class="vc-btn vc-btn-pri vc-btn-lg" href={c.cta.primaryHref}>{c.cta.primary}</a></div>
      <div class="vc-read" aria-live="polite" data-vc-read>
        <p class="vc-read-idle">Pick a point on the map to see what it is.</p>
      </div>
    </div>
    <div class="vc-map" data-visual="map" data-side="none"></div>
  </header>

  <section class="vc-places" aria-label="The place">
    <h2>{c.map.title}</h2>
    <p class="vc-lead">{c.map.lead}</p>
    <ul class="vc-place-list">{places.map(([t, x]) => <li><b>{t}</b><span>{x}</span></li>)}</ul>
  </section>

  <section class="vc-sec" id="trace">
    <div class="vc-head">
      <h2>One field, back to the sawmill.</h2>
      <p class="vc-lead">Zoom in on a single removal. Each square is a record; click one to see what it came from and what it became.</p>
    </div>
    <div data-visual="chain"></div>
  </section>

  <section class="vc-sec">
    <div class="vc-head">
      <h2>{c.dense.title}</h2>
      <p class="vc-lead">Zoom out to the whole plant. {c.dense.lead}</p>
    </div>
    <div data-visual="dense" data-jump="true"></div>
    <div class="vc-shots">{c.dense.screenshots.map((s) => <div class="vc-shot"><div class="vc-shot-bar"><i></i><i></i><i></i></div><div class="vc-shot-ph">Screenshot: {s}</div></div>)}</div>
  </section>

  <section class="vc-cmp" aria-labelledby="vc-cmp-h">
    <div class="vc-cmp-in">
      <h2 id="vc-cmp-h">{c.compare.title}</h2>
      <div class="vc-cmp-scroll">
        <table>
          <thead><tr><th scope="col"><span class="vc-sr">Task</span></th>{c.compare.columns.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{c.compare.rows.map(([a, b, d]) => <tr><th scope="row">{a}</th><td>{b}</td><td>{d}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="vc-sec" id="features">
    <div class="vc-head">
      <h2>{c.features.title}</h2>
      <p class="vc-lead">{c.features.lead}</p>
    </div>
    <div class="vc-feat-wrap">
      <ol class="vc-ledger">{c.features.shipped.map(([g, d, t, x], i) => <li><span class="vc-idx">{String(i + 1).padStart(2, "0")}</span><Fragment set:html={featIcon(g, d)} /><div><h3>{t}</h3><p>{x}</p></div></li>)}</ol>
      <aside class="vc-inset">
        <h3>{c.features.bins.title}</h3>
        <p class="vc-sub">{c.features.bins.text}</p>
        <div data-visual="bins"></div>
        <p class="vc-hint">{c.features.bins.hint}</p>
      </aside>
    </div>
    <div class="vc-up">
      <h3>Next</h3>
      <ul>{c.features.upcoming.map(([g, d, t, x]) => <li><div class="vc-up-h"><Fragment set:html={featIcon(g, d)} /><span class="vc-chip">{c.features.upcomingLabel}</span></div><b>{t}</b><span>{x}</span></li>)}</ul>
    </div>
  </section>

  <section class="vc-sec" id="registry">
    <div class="vc-head">
      <h2>{c.registry.title}</h2>
      <p class="vc-lead">{c.registry.lead}</p>
    </div>
    <div class="vc-card"><div data-visual="morph"></div></div>
    <div class="vc-proof">
      <div class="vc-logos"><span class="vc-hint">{c.proof.label}</span>{c.proof.logos.map((l) => <span class="vc-logo-ph">{l}</span>)}</div>
      <p class="vc-figs">{c.proof.figures.map((f) => <span><b>{f.value}</b> {f.text}</span>)}</p>
    </div>
  </section>

  <section class="vc-sec" id="open-source">
    <h2>{c.openSource.title}</h2>
    <div class="vc-two">{c.openSource.cards.map((k) => <div class="vc-card vc-stack"><span class="vc-chip">{k.chip}</span><h3>{k.title}</h3><p class="vc-sub">{k.text}</p><div><a class="vc-btn" href={k.href}>{k.action}</a></div></div>)}</div>
  </section>

  <section class="vc-sec" id="walkthrough">
    <div class="vc-form-grid">
      <div class="vc-stack"><h2>{c.walkthrough.title}</h2><p class="vc-lead">{c.walkthrough.lead}</p></div>
      <div class="vc-card"><WalkthroughForm idPrefix="vc" /></div>
    </div>
  </section>

  <footer class="vc-foot"><span>{c.footer.left}</span><span>{c.footer.right} <a href={c.cta.githubHref}>GitHub</a></span></footer>
</div>

<style>
  .vc { max-width: 1480px; margin: 0 auto; padding-inline: 20px; }
  .vc-nav { display: flex; align-items: center; gap: 22px; padding-block: 16px; flex-wrap: wrap; }
  .vc-logo { display: flex; align-items: baseline; gap: 7px; margin-right: auto; }
  .vc-logo b { font-size: 24px; letter-spacing: -0.02em; }
  .vc-logo span { font-size: 13px; color: var(--ink-3); }
  .vc-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .vc-links a { font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .vc a:focus-visible, .vc button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .vc h2 { font-size: clamp(28px, 3.6vw, 48px); letter-spacing: -0.03em; line-height: 1.05; max-width: 20ch; }
  .vc h3 { font-size: 18px; }
  .vc-lead { font-size: clamp(16px, 1.4vw, 19px); color: var(--ink-2); max-width: 58ch; }
  .vc-sub { color: var(--ink-2); }
  .vc-hint { font-size: 13px; color: var(--ink-3); }
  .vc-stack { display: grid; gap: 12px; align-content: start; }
  .vc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .vc-btn { display: inline-block; border: 1.5px solid var(--ink); border-radius: 8px; padding: 9px 16px; font-weight: 700; font-size: 15px; text-decoration: none; background: var(--paper); }
  .vc-btn-pri { background: var(--ink); color: var(--paper); }
  .vc-btn-lg { padding: 13px 22px; font-size: 17px; }
  .vc-btn-sm { padding: 7px 12px; font-size: 13px; }
  .vc-chip { display: inline-flex; justify-self: start; font-size: 11.5px; font-weight: 700; border-radius: 999px; padding: 2px 9px; background: var(--infra-bg); color: var(--infra); }
  .vc-card { background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 10px; padding: 22px; min-width: 0; }

  /* hero: panel beside the map, map takes the width */
  .vc-hero { display: grid; grid-template-columns: minmax(300px, 400px) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .vc-panel { background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 12px; padding: 26px; display: grid; gap: 18px; align-content: start; }
  .vc-panel h1 { font-size: clamp(34px, 3.2vw, 48px); letter-spacing: -0.04em; line-height: 1.02; }
  .vc-panel .vc-lead { font-size: 15.5px; }
  .vc-map { min-width: 0; align-self: stretch; min-height: 340px; }
  .vc-map :global(.nv-main), .vc-map :global(.nv-scroll) { height: 100%; }
  .vc-read { border-top: 1.5px solid var(--hair-strong); padding-top: 14px; font-size: 14px; display: grid; gap: 4px; min-height: 96px; align-content: start; }
  .vc-read-idle { color: var(--ink-3); }
  .vc-read b { font-size: 20px; letter-spacing: -0.01em; }
  .vc-read span { color: var(--ink-2); }
  @media (max-width: 900px) { .vc-hero { grid-template-columns: 1fr; } .vc-panel { padding: 20px; } }

  .vc-places { padding-block: 72px 20px; display: grid; gap: 16px; }
  .vc-place-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1.5px solid var(--hair-strong); }
  .vc-place-list li { display: grid; gap: 4px; padding: 16px 20px 16px 0; align-content: start; }
  .vc-place-list b { font-size: 20px; letter-spacing: -0.01em; }
  .vc-place-list span { color: var(--ink-2); font-size: 15px; }

  .vc-sec { padding-block: 72px; display: grid; gap: 28px; scroll-margin-top: 20px; }
  .vc-head { display: grid; gap: 14px; }
  @media (max-width: 700px) { .vc-sec { padding-block: 44px; } .vc-places { padding-block: 44px 10px; } }
  .vc-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .vc-shot { border: 1.5px solid var(--hair-2); border-radius: 8px; background: var(--paper); overflow: hidden; display: grid; grid-template-rows: auto 1fr; aspect-ratio: 16/10; }
  .vc-shot-bar { display: flex; gap: 5px; padding: 8px 10px; border-bottom: 1px solid var(--hair); }
  .vc-shot-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--hair-2); }
  .vc-shot-ph { display: grid; place-items: center; color: var(--ink-3); font-size: 13px; padding: 16px; text-align: center; background: repeating-linear-gradient(135deg, var(--sea) 0 10px, transparent 10px 20px); }

  /* comparison: full-bleed ink band */
  .vc-cmp { background: var(--ink); color: var(--paper); margin-inline: calc(50% - 50vw); padding: 72px 20px; }
  .vc-cmp-in { max-width: 1440px; margin: 0 auto; display: grid; gap: 30px; }
  .vc-cmp h2 { font-size: clamp(30px, 4.4vw, 64px); max-width: 16ch; }
  .vc-cmp-scroll { overflow-x: auto; }
  .vc-cmp table { border-collapse: collapse; width: 100%; min-width: 680px; font-size: clamp(15px, 1.4vw, 19px); }
  .vc-cmp th, .vc-cmp td { text-align: left; padding: 16px 20px 16px 0; border-top: 1px solid rgba(255, 255, 255, 0.28); vertical-align: top; }
  .vc-cmp thead th { border-top: 0; font-size: 13px; font-weight: 700; color: var(--clr-rose); padding-bottom: 8px; }
  .vc-cmp tbody th { font-weight: 300; width: 36%; color: rgba(255, 255, 255, 0.72); }
  .vc-cmp td { color: rgba(255, 255, 255, 0.5); }
  .vc-cmp td:last-child { color: var(--paper); font-weight: 700; }
  @media (max-width: 700px) { .vc-cmp { padding: 44px 20px; } }

  /* features ledger */
  .vc-feat-wrap { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 36px; align-items: start; }
  @media (max-width: 960px) { .vc-feat-wrap { grid-template-columns: 1fr; } }
  .vc-ledger { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--hair-strong); }
  .vc-ledger li { display: grid; grid-template-columns: 34px 32px minmax(0, 1fr); gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--hair); align-items: start; }
  .vc-idx { font-family: var(--f-mono); font-size: 13px; color: var(--ink-3); padding-top: 3px; }
  .vc-ledger :global(svg) { width: 30px; height: 30px; }
  .vc-ledger h3 { margin-bottom: 3px; }
  .vc-ledger p { font-size: 14.5px; color: var(--ink-2); }
  .vc-inset { position: sticky; top: 16px; background: var(--paper); border: 1.5px solid var(--hair-2); border-radius: 12px; padding: 22px; display: grid; gap: 12px; min-width: 0; }
  .vc-inset h3 { font-size: 24px; letter-spacing: -0.02em; }
  @media (max-width: 960px) { .vc-inset { position: static; } }

  .vc-up { display: grid; gap: 12px; margin-top: 8px; }
  .vc-up ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
  .vc-up li { display: grid; gap: 4px; align-content: start; padding: 14px; border: 1.5px dashed var(--hair-2); border-radius: 10px; font-size: 13.5px; }
  .vc-up li b { font-size: 15px; }
  .vc-up li span { color: var(--ink-2); }
  .vc-up-h { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .vc-up :global(svg) { width: 26px; height: 26px; }

  .vc-proof { display: grid; gap: 14px; }
  .vc-logos { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .vc-logo-ph { border: 1.5px dashed var(--hair-2); border-radius: 6px; padding: 10px 16px; font-weight: 700; color: var(--ink-2); font-size: 14px; background: var(--paper); }
  .vc-figs { display: flex; flex-wrap: wrap; gap: 8px 32px; font-size: 15px; color: var(--ink-2); }
  .vc-figs b { color: var(--ink); font-size: 22px; letter-spacing: -0.02em; margin-right: 4px; }
  .vc-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
  .vc-two h3 { font-size: 22px; }
  .vc-form-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 32px; align-items: start; }
  @media (max-width: 900px) { .vc-form-grid { grid-template-columns: 1fr; } }
  .vc-foot { padding-block: 28px 80px; border-top: 1px solid var(--hair); display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; font-size: 13px; color: var(--ink-3); }
</style>

<script>
  import { onShown } from "../lib/variant.js";
  onShown("C", (root) => {
    const map = root.querySelector('[data-visual="map"]') as HTMLElement | null;
    const read = root.querySelector("[data-vc-read]") as HTMLElement | null;
    if (!map || !read) return;
    const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch as "&"]!);
    const idle = read.innerHTML;
    map.addEventListener("noma:select", (e) => {
      const node = (e as CustomEvent).detail?.node;
      if (!node) { read.innerHTML = idle; return; }
      read.innerHTML = `<b>${esc(node.code)}</b>` + (node.meta || []).map((m: string) => `<span>${esc(m)}</span>`).join("");
    });
  });
</script>
